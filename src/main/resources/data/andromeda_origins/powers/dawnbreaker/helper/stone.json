{
  "type": "origins:multiple",
  "hidden": true,
  "color": {
    "type": "origins:model_color",
    "red": 0.66,
    "green": 0.67,
    "blue": 0.63,
    "alpha": 1,
    "condition": {
      "type": "origins:or",
      "conditions": [
        {
          "type": "origins:resource",
          "resource": "*:*_gradual",
          "comparison": "==",
          "compare_to": 0
        },
        {
          "type": "origins:resource",
          "resource": "*:*_progress",
          "comparison": ">=",
          "compare_to": 40
        }
      ]
    }
  },
  "timer": {
    "type": "origins:action_over_time",
    "interval": 1,
    "condition": {
      "type": "origins:power",
      "power": "andromeda_origins:dawnbreaker/helper/ophidianed",
      "inverted": true
    },
    "entity_action": {
      "type": "origins:revoke_power",
      "power": "*:*",
      "source": "andromeda_origins:dawnbreaker_effect"
    }
  },
  "progress": {
    "type": "origins:resource",
    "min": 0,
    "max": 40,
    "start_value": 0,
    "hud_render": {
      "should_render": false
    }
  },
  "gradual": {
    "type": "origins:resource",
    "min": 0,
    "max": 1,
    "start_value": 0,
    "hud_render": {
      "should_render": false
    }
  },
  "progress_tick": {
    "type": "origins:action_over_time",
    "interval": 1,
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "*:*_progress",
      "change": 1
    }
  }
}
