{
  "type": "origins:multiple",
  "name": "Begone",
  "description": "Banish the player or living mob you look at within 32 blocks approximately 500 blocks away from you, relative to their current position. Same dimension only; searches for a safe nearby landing within 8 blocks of the destination. No cooldown.",
  "cooldown": {
    "type": "origins:resource",
    "min": 0,
    "max": 1800,
    "start_value": 0,
    "hud_render": {
      "should_render": false
    }
  },
  "cooldown_tick": {
    "type": "origins:action_over_time",
    "interval": 1,
    "condition": {
      "type": "origins:resource",
      "resource": "*:*_cooldown",
      "comparison": ">",
      "compare_to": 0
    },
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "*:*_cooldown",
      "change": -1
    }
  },
  "cast": {
    "type": "origins:active_self",
    "cooldown": 1,
    "hud_render": {
      "should_render": false
    },
    "key": {
      "key": "key.andromeda_origins.begone",
      "continuous": false
    },
    "entity_action": {
      "type": "andromeda_origins:dawnbreaker",
      "kind": "begone"
    }
  },
  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/toggle.png",
      "text": [
        "Activate with ",
        {
          "keybind": "key.andromeda_origins.begone"
        }
      ],
      "fallback": "andromeda_origins:textures/gui/badge/fallback.png"
    }
  ]
}
