{
  "type": "origins:multiple",
  "name": "Sovereign Ophidian Gaze",
  "description": "Petrify up to five visible foes in a 60-degree forward cone within 24 blocks for 30 seconds. Repeated casts extend petrification up to 60 seconds. Direction keys break free faster; pumpkin protection and Unstoppable remain effective. Two charges; 60-second effective recharge after both are spent.",
  "charges": {
    "type": "origins:resource",
    "min": 0,
    "max": 2,
    "start_value": 2,
    "hud_render": {
      "should_render": false
    }
  },
  "recharge": {
    "type": "origins:resource",
    "min": 0,
    "max": 1200,
    "start_value": 0,
    "hud_render": {
      "sprite_location": "andromeda_origins:textures/gui/resource_bars_1.png",
      "bar_index": 14,
      "condition": {
        "type": "origins:resource",
        "resource": "*:*_recharge",
        "comparison": ">",
        "compare_to": 0
      },
      "fallback": {
        "sprite_location": "apoli:textures/gui/resource_bar.png",
        "bar_index": 0,
        "icon_index": 0
      }
    },
    "min_action": {
      "type": "origins:change_resource",
      "resource": "*:*_charges",
      "operation": "set",
      "change": 2
    }
  },
  "recharge_tick": {
    "type": "origins:action_over_time",
    "interval": 1,
    "condition": {
      "type": "origins:resource",
      "resource": "*:*_recharge",
      "comparison": ">",
      "compare_to": 0
    },
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "*:*_recharge",
      "change": -1
    }
  },
  "cast": {
    "type": "origins:active_self",
    "cooldown": 1,
    "hud_render": {
      "should_render": false
    },
    "key": {
      "key": "key.origins.primary_active",
      "continuous": false
    },
    "entity_action": {
      "type": "andromeda_origins:dawnbreaker",
      "kind": "gaze"
    }
  },
  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/toggle.png",
      "text": [
        "Activate with ",
        {
          "keybind": "key.origins.primary_active"
        }
      ],
      "fallback": "andromeda_origins:textures/gui/badge/fallback.png"
    }
  ]
}
