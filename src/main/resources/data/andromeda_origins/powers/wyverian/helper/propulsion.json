{
  "type": "origins:multiple",
  "remove": {
    "type": "origins:resource",
    "min": 0,
    "max": 10,
    "start_value": 10,
    "hud_render": {
      "should_render": false
    },
    "min_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:change_resource",
          "resource": "andromeda_origins:common/figura_4",
          "change": -1
        },
        {
          "type": "origins:revoke_power",
          "power": "*:*",
          "source": "minecraft:state"
        }
      ]
    }
  },
  "timer": {
    "type": "origins:action_over_time",
    "interval": 1,
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:add_velocity",
          "set": true,
          "z": 0.8,
          "space": "local"
        },
        {
          "type": "origins:change_resource",
          "resource": "*:*_remove",
          "change": -1,
          "operation": "add"
        }
      ]
    }
  }
}
