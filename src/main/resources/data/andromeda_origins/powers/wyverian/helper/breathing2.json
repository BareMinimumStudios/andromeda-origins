{
  "type": "origins:multiple",
  "remove": {
    "type": "origins:resource",
    "min": 0,
    "max": 2,
    "start_value": 2,
    "hud_render": {
      "should_render": false
    },
    "min_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:change_resource",
          "resource": "andromeda_origins:common/figura_2",
          "change": -1
        },
        {
          "type": "origins:change_resource",
          "resource": "andromeda_origins:wyverian/primary_fireball",
          "change": 0,
          "operation": "set"
        },
        {
          "type": "origins:revoke_power",
          "power": "*:*",
          "source": "minecraft:state"
        }
      ]
    }
  },
  "timer": {
    "type": "origins:action_over_time",
    "interval": 5,
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "*:*_remove",
      "change": -1,
      "operation": "add"
    }
  },
  "shake": {
    "type": "origins:shaking"
  },
  "glow": {
    "type": "origins:self_glow",
    "use_teams": false,
    "red": 1,
    "green": 0.23,
    "blue": 0.23,
    "condition": {
      "type": "origins:power",
      "power": "*:common/undetectable",
      "inverted": true
    }
  }
}
