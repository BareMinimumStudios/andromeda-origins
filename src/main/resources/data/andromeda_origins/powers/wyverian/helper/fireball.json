{
  "type": "origins:multiple",
  "model": {
    "type": "origins:model_color",
    "red": 0.1,
    "green": 0.1,
    "blue": 0.1,
    "alpha": 0
  },
  "no_collision": {
    "type": "origins:prevent_entity_collision"
  },
  "antigrav": {
    "type": "origins:modify_falling",
    "velocity": 0.01,
    "take_fall_damage": false
  },
  "death": {
    "type": "origins:resource",
    "min": 0,
    "max": 1,
    "start_value": 1,
    "hud_render": {
      "should_render": false
    },
    "min_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:area_of_effect",
          "radius": 4,
          "bientity_action": {
            "type": "origins:and",
            "actions": [
              {
                "type": "origins:add_velocity",
                "z": 2
              },
              {
                "type": "origins:target_action",
                "action": {
                  "type": "origins:and",
                  "actions": [
                    {
                      "type": "origins:spawn_particles",
                      "particle": {
                        "type": "minecraft:lava"
                      },
                      "count": 5,
                      "speed": 0.0,
                      "force": true,
                      "offset_y": 1,
                      "spread": {
                        "x": 0,
                        "y": 0,
                        "z": 0
                      }
                    },
                    {
                      "type": "origins:damage",
                      "amount": 10,
                      "damage_type": "minecraft:explosion"
                    }
                  ]
                }
              }
            ]
          },
          "bientity_condition": {
            "type": "origins:and",
            "conditions": [
              {
                "type": "origins:can_see"
              },
              {
                "type": "origins:target_condition",
                "condition": {
                  "type": "origins:living"
                }
              }
            ]
          }
        },
        {
          "type": "origins:execute_command",
          "command": "kill @s"
        },
        {
          "type": "origins:execute_command",
          "command": "tp @s ~ ~-300 ~"
        }
      ]
    }
  },
  "timer": {
    "type": "origins:action_over_time",
    "interval": 1,
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "*:*_death",
      "change": -1
    }
  }
}
