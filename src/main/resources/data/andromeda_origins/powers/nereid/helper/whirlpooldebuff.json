{
  "type": "origins:multiple",
  "callback": {
    "type": "origins:action_on_callback",
    "entity_action_removed": {
      "type": "andromeda_origins:tag",
      "tag": "andromeda_nereid_submersion_drown",
      "operation": "remove"
    }
  },
  "remove": {
    "type": "origins:resource",
    "min": 0,
    "max": 240,
    "start_value": 20,
    "hud_render": {
      "should_render": true,
      "sprite_location": "andromeda_origins:textures/gui/resource_bars_2.png",
      "bar_index": 1
    },
    "min_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "andromeda_origins:tag",
          "tag": "andromeda_nereid_submersion_drown",
          "operation": "remove"
        },
        {
          "type": "origins:revoke_power",
          "power": "*:*",
          "source": "andromeda_origins:nereid_submersion"
        },
        {
          "type": "origins:revoke_power",
          "power": "*:*",
          "source": "minecraft:debuff"
        }
      ]
    }
  },
  "timer": {
    "type": "origins:action_over_time",
    "interval": 5,
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "*:*_remove",
      "change": -1,
      "operation": "add"
    }
  },
  "pull": {
    "type": "origins:action_over_time",
    "interval": 1,
    "entity_action": {
      "type": "origins:add_velocity",
      "y": -0.08,
      "space": "world",
      "set": false
    },
    "condition": {
      "type": "origins:submerged_in",
      "fluid": "minecraft:water"
    }
  },
  "swim_lock": {
    "type": "origins:conditioned_attribute",
    "tick_rate": 10,
    "modifier": {
      "id": "andromeda_origins:nereid_submersion_swim_lock",
      "operation": "multiply_total_multiplicative",
      "amount": -0.95,
      "attribute": "additionalentityattributes:generic.water_speed"
    },
    "condition": {
      "type": "origins:submerged_in",
      "fluid": "minecraft:water"
    }
  },
  "bottom_drag": {
    "type": "origins:conditioned_attribute",
    "modifier": {
      "id": "andromeda_origins:nereid_submersion_bottom_drag",
      "attribute": "minecraft:generic.movement_speed",
      "operation": "multiply_total_multiplicative",
      "amount": -0.85
    },
    "condition": {
      "type": "origins:submerged_in",
      "fluid": "minecraft:water"
    },
    "tick_rate": 1
  },
  "jump_lock": {
    "type": "origins:modify_jump",
    "modifier": {
      "operation": "max_total",
      "amount": -1
    },
    "condition": {
      "type": "origins:submerged_in",
      "fluid": "minecraft:water"
    }
  },
  "visual": {
    "type": "origins:particle",
    "count": 5,
    "particle": "minecraft:bubble_pop",
    "spread": {
      "x": 0.25,
      "y": 0.25,
      "z": 0.25
    },
    "offset_y": 1,
    "frequency": 10
  }
}
