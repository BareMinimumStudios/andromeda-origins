{
  "type": "origins:multiple",
  "remove": {
    "type": "origins:resource",
    "min": 0,
    "max": 15,
    "start_value": 15,
    "hud_render": {
      "should_render": false
    },
    "min_action": {
      "type": "origins:revoke_power",
      "power": "*:*",
      "source": "andromeda_origins:nereid_mark"
    }
  },
  "timer": {
    "type": "origins:action_over_time",
    "interval": 20,
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "*:*_remove",
      "change": -1,
      "operation": "add"
    }
  },
  "glow": {
    "type": "origins:self_glow",
    "use_teams": false,
    "red": 0.5,
    "blue": 1,
    "green": 0.6,
    "entity_condition": {
      "type": "origins:or",
      "conditions": [
        {
          "type": "origins:origin",
          "origin": "andromeda_origins:nereid",
          "layer": "origins:origin"
        },
        {
          "type": "origins:origin",
          "origin": "andromeda_origins:champion_nereid",
          "layer": "origins:origin"
        }
      ]
    },
    "condition": {
      "type": "origins:power",
      "power": "*:common/undetectable",
      "inverted": true
    }
  }
}
