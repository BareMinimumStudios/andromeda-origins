{
  "type": "origins:multiple",
  "callback": {
    "type": "origins:action_on_callback",
    "entity_action_added": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:grant_power",
          "power": "*:common/silenced",
          "source": "minecraft:ccontrol"
        },
        {
          "type": "origins:change_resource",
          "resource": "*:common/silenced_sources",
          "change": 1
        },
        {
          "type": "origins:execute_command",
          "command": "title @s actionbar {\"text\": \"Your skin feels dry!\", \"color\": \"red\"}"
        }
      ]
    },
    "entity_action_lost": {
      "type": "origins:change_resource",
      "resource": "*:common/silenced_sources",
      "change": -1
    }
  },
  "speed": {
    "type": "origins:attribute",
    "modifier": {
      "id": "*:*",
      "attribute": "minecraft:generic.movement_speed",
      "operation": "add_multiplied_total",
      "amount": -0.1
    }
  }
}
