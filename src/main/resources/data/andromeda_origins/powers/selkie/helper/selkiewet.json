{
  "type": "origins:multiple",
  "callback": {
    "type": "origins:action_on_callback",
    "entity_action_added": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:grant_power",
          "power": "*:common/wet",
          "source": "minecraft:debuff"
        },
        {
          "type": "origins:change_resource",
          "resource": "*:common/wet_sources",
          "change": 1
        },
        {
          "type": "origins:execute_command",
          "command": "title @s actionbar {\"text\": \"You feel hydrated!\", \"color\": \"green\"}"
        }
      ]
    },
    "entity_action_lost": {
      "type": "origins:change_resource",
      "resource": "*:common/wet_sources",
      "change": -1
    }
  },
  "remove": {
    "type": "origins:resource",
    "min": 0,
    "max": 180,
    "start_value": 180,
    "hud_render": {
      "sprite_location": "origins:textures/gui/community/huang/resource_bar_02.png",
      "bar_index": 3
    },
    "min_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:grant_power",
          "power": "*:selkie/helper/groundweak",
          "source": "minecraft:state"
        },
        {
          "type": "origins:change_resource",
          "resource": "*:selkie/passives_recharge_shawl",
          "change": 0,
          "operation": "set"
        },
        {
          "type": "origins:revoke_power",
          "power": "*:*",
          "source": "minecraft:debuff"
        }
      ]
    }
  },
  "timer": {
    "type": "origins:action_over_time",
    "interval": 20,
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:if_else_list",
          "actions": [
            {
              "condition": {
                "type": "origins:and",
                "conditions": [
                  {
                    "type": "origins:resource",
                    "resource": "*:*_remove",
                    "comparison": "<",
                    "compare_to": 180
                  },
                  {
                    "type": "origins:or",
                    "conditions": [
                      {
                        "type": "origins:fluid_height",
                        "fluid": "minecraft:water",
                        "comparison": ">",
                        "compare_to": 0
                      },
                      {
                        "type": "origins:in_rain"
                      }
                    ]
                  }
                ]
              },
              "action": {
                "type": "origins:change_resource",
                "resource": "*:*_remove",
                "change": 1
              }
            },
            {
              "condition": {
                "type": "origins:and",
                "conditions": [
                  {
                    "type": "origins:resource",
                    "resource": "*:*_remove",
                    "comparison": ">",
                    "compare_to": 0
                  },
                  {
                    "type": "origins:fluid_height",
                    "fluid": "minecraft:water",
                    "comparison": "==",
                    "compare_to": 0
                  },
                  {
                    "type": "origins:in_rain",
                    "inverted": true
                  }
                ]
              },
              "action": {
                "type": "origins:change_resource",
                "resource": "*:*_remove",
                "change": -1
              }
            }
          ]
        },
        {
          "type": "origins:gain_air",
          "value": 200
        }
      ]
    }
  },
  "visual": {
    "type": "origins:particle",
    "count": 5,
    "particle": "minecraft:falling_water",
    "spread": {
      "x": 0.25,
      "y": 0.25,
      "z": 0.25
    },
    "offset_y": 1,
    "frequency": 10
  }
}
