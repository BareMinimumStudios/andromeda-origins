{
  "type": "origins:multiple",
  "astamina": {
    "type": "origins:resource",
    "min": 0,
    "max": 10,
    "start_value": 10,
    "hud_render": {
      "should_render": true,
      "sprite_location": "andromeda_origins:textures/gui/resource_bars_1.png",
      "bar_index": 7
    },
    "min_action": {
      "type": "origins:change_resource",
      "resource": "*:*_breathlock",
      "change": 1
    },
    "max_action": {
      "type": "origins:change_resource",
      "resource": "*:*_breathlock",
      "change": -1
    }
  },
  "breathlock": {
    "type": "origins:resource",
    "min": 0,
    "max": 1,
    "start_value": 0,
    "hud_render": {
      "should_render": false
    },
    "max_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:execute_command",
          "command": "title @s actionbar {\"text\": \"You have run out of dust!\", \"color\": \"red\"}"
        },
        {
          "type": "origins:play_sound",
          "sound": "andromeda_origins:ability.faerie.dust_depleted",
          "volume": 0.75,
          "pitch": 1.0
        }
      ]
    },
    "min_action": {
      "type": "origins:execute_command",
      "command": "title @s actionbar {\"text\": \"You can use Flutter again!\", \"color\": \"green\"}"
    }
  },
  "soundcooldown": {
    "type": "origins:cooldown",
    "cooldown": 20,
    "hud_render": {
      "should_render": false
    }
  },
  "grrr": {
    "type": "origins:active_self",
    "cooldown": 60,
    "hud_render": {
      "should_render": false
    },
    "entity_action": {
      "type": "origins:if_else",
      "condition": {
        "type": "origins:resource",
        "comparison": "==",
        "resource": "*:*_breathlock",
        "compare_to": 0
      },
      "if_action": {
        "type": "origins:and",
        "actions": [
          {
            "type": "origins:play_sound",
            "sound": "andromeda_origins:ability.faerie.fae_chime",
            "volume": 0.55,
            "pitch": 1.0
          },
          {
            "type": "origins:delay",
            "ticks": 3,
            "action": {
              "type": "origins:and",
              "actions": [
                {
                  "type": "origins:execute_command",
                  "command": "playsound minecraft:entity.allay.ambient_with_item master @s ~ ~ ~ 2.0 1.15 1.0"
                },
                {
                  "type": "origins:execute_command",
                  "command": "playsound minecraft:entity.allay.ambient_with_item player @a[distance=0.1..24] ~ ~ ~ 1.35 1.15 0"
                }
              ]
            }
          },
          {
            "type": "origins:delay",
            "ticks": 8,
            "action": {
              "type": "origins:and",
              "actions": [
                {
                  "type": "origins:execute_command",
                  "command": "playsound minecraft:entity.vex.ambient master @s ~ ~ ~ 1.65 1.35 1.0"
                },
                {
                  "type": "origins:execute_command",
                  "command": "playsound minecraft:entity.vex.ambient player @a[distance=0.1..24] ~ ~ ~ 1.1 1.35 0"
                }
              ]
            }
          }
        ]
      },
      "else_action": {
        "type": "origins:execute_command",
        "command": "title @s actionbar {\"text\": \"Your wings are out of dust, let it fully regenerate!\", \"color\": \"red\"}"
      }
    },
    "key": {
      "key": "key.origins.primary_active",
      "continuous": false
    }
  },
  "active": {
    "type": "origins:active_self",
    "cooldown": 2,
    "hud_render": {
      "should_render": false
    },
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:if_else_list",
          "actions": [
            {
              "condition": {
                "type": "origins:resource",
                "comparison": "==",
                "resource": "*:*_soundcooldown",
                "compare_to": 0
              },
              "action": {
                "type": "origins:and",
                "actions": [
                  {
                    "type": "origins:trigger_cooldown",
                    "power": "*:*_soundcooldown"
                  },
                  {
                    "type": "origins:change_resource",
                    "resource": "*:*_astamina",
                    "change": -1
                  },
                  {
                    "type": "origins:play_sound",
                    "sound": "minecraft:entity.parrot.fly",
                    "volume": 2,
                    "pitch": 0.8
                  },
                  {
                    "type": "origins:play_sound",
                    "sound": "minecraft:block.amethyst_cluster.hit",
                    "volume": 0.6,
                    "pitch": 1.6
                  },
                  {
                    "type": "origins:spawn_particles",
                    "particle": {
                      "type": "minecraft:end_rod"
                    },
                    "count": 2,
                    "speed": 0.01,
                    "force": true,
                    "spread": {
                      "x": 0.25,
                      "y": 0.4,
                      "z": 0.25
                    },
                    "offset_y": 0.8
                  },
                  {
                    "type": "origins:spawn_particles",
                    "particle": {
                      "type": "minecraft:glow"
                    },
                    "count": 4,
                    "speed": 0.0,
                    "force": true,
                    "spread": {
                      "x": 0.2,
                      "y": 0.3,
                      "z": 0.2
                    },
                    "offset_y": 0.8
                  },
                  {
                    "type": "origins:spawn_particles",
                    "particle": {
                      "type": "minecraft:wax_on"
                    },
                    "count": 2,
                    "speed": 0.02,
                    "force": true,
                    "spread": {
                      "x": 0.2,
                      "y": 0.25,
                      "z": 0.2
                    },
                    "offset_y": 0.8
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "origins:change_resource",
          "resource": "*:common/figura_1",
          "change": 1,
          "operation": "set"
        },
        {
          "type": "origins:grant_power",
          "power": "*:faerie/helper/hover",
          "source": "minecraft:state"
        },
        {
          "type": "origins:change_resource",
          "resource": "*:faerie/helper/hover_remove",
          "change": 2
        }
      ]
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:power",
          "power": "*:common/silenced",
          "inverted": true
        },
        {
          "type": "origins:power",
          "power": "*:common/restrained",
          "inverted": true
        },
        {
          "type": "origins:resource",
          "comparison": ">",
          "resource": "*:*_astamina",
          "compare_to": 0
        },
        {
          "type": "origins:resource",
          "comparison": "==",
          "resource": "*:*_breathlock",
          "compare_to": 0
        }
      ]
    },
    "key": {
      "key": "key.origins.primary_active",
      "continuous": true
    }
  },
  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/toggle.png",
      "text": [
        "Trigger with ",
        {
          "keybind": "key.origins.primary_active"
        }
      ]
    }
  ],
  "name": "Flutter",
  "description": "Faerie Dust regenerates while this ability is not in use. Hold your Primary Ability key to flutter, dramatically slowing your fall while allowing free horizontal movement. Flutter cannot gain altitude. §e§lMovement Ability§r."
}
