  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/community/silent/badge/shapes/shape_heart.png",
      "text": "§e§lDamage Resistances:§r§f Falling (-100%).\n \n§c§lDamage Vulnerabilities:§r§f Iron weapons (+20%).\n \n§e§lEffect Immunities:§r§f Levitation."
    },
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/community/silent/badge/colors/red.png",
      "text": "§e§lUndetectable:§r§f Immune to detection effects, glowing and entity collision. Invisible for the duration."
    }
  ],
  "name": "Passive Features",
  "description": "§e§lStats:§r\n-17% Size\n-20% Max Health\n+33% Ground & Air Speed\n-15% Damage Dealt\n \n§e§lFeatures:§r\n- Hiding in crops, grass, flowers, or leaves makes you §e§lUndetectable§r and grants perfect vision in darkness. While Undetectable, detection and glow abilities cannot reveal you.\n- Dealing damage disables this concealment for 10 seconds.\n- Iron weapons deal 20% more damage to you and inflict Wither I. Carrying any iron-tagged item anywhere in your inventory also inflicts Wither I.",
  "size": {
    "type": "origins:attribute",
    "modifier": {
      "id": "andromeda_origins:faerie_passives_size",
      "attribute": "minecraft:generic.scale",
      "operation": "add_multiplied_total",
      "amount": -0.17
    }
  }
