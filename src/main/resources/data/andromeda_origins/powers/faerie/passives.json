  "revokestealth": {
    "type": "origins:self_action_on_hit",
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:trigger_cooldown",
          "power": "*:*_stealthcooldown"
        },
        {
          "type": "origins:revoke_power",
          "power": "*:common/undetectable",
          "source": "minecraft:buff"
        }
      ]
    },
    "condition": {
      "type": "origins:resource",
      "resource": "*:*_stealthstate",
      "comparison": "==",
      "compare_to": 1
    },
    "cooldown": 20
  },
  "stealthcooldown": {
    "type": "origins:cooldown",
    "cooldown": 200,
    "hud_render": {
      "should_render": true,
      "bar_index": 3
    }
  },
  "stealthstate": {
    "type": "origins:resource",
    "min": 0,
    "max": 1,
    "start_value": 0,
    "hud_render": {
      "should_render": true,
      "sprite_location": "origins:textures/gui/community/spiderkolo/resource_bar_02.png",
      "bar_index": 7,
      "order": 6,
      "condition": {
        "type": "origins:resource",
        "resource": "*:*_stealthstate",
        "comparison": "==",
        "compare_to": 1
      }
    },
    "min_action": {
      "type": "origins:revoke_power",
      "power": "*:common/undetectable",
      "source": "minecraft:buff"
    },
    "max_action": {
      "type": "origins:grant_power",
      "power": "*:common/undetectable",
      "source": "minecraft:buff"
    }
  },
  "heart": {
    "type": "origins:action_over_time",
    "interval": 20,
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:if_else_list",
          "actions": [
            {
              "condition": {
                "type": "origins:and",
                "conditions": [
                  {
                    "type": "origins:fluid_height",
                    "fluid": "minecraft:water",
                    "comparison": "==",
                    "compare_to": 0
                  },
                  {
                    "type": "origins:resource",
                    "resource": "*:*_stealthstate",
                    "comparison": "==",
                    "compare_to": 0
                  },
                  {
                    "type": "origins:resource",
                    "resource": "*:*_stealthcooldown",
                    "comparison": "==",
                    "compare_to": 0
                  },
                  {
                    "type": "origins:in_block_anywhere",
                    "block_condition": {
                      "type": "origins:or",
                      "conditions": [
                        {
                          "type": "origins:in_tag",
                          "tag": "minecraft:crops"
                        },
                        {
                          "type": "origins:in_tag",
                          "tag": "minecraft:flowers"
                        },
                        {
                          "type": "origins:in_tag",
                          "tag": "minecraft:replaceable_by_trees"
                        }
                      ]
                    },
                    "comparison": ">",
                    "compare_to": 0
                  }
                ]
              },
              "action": {
                "type": "origins:change_resource",
                "resource": "*:*_stealthstate",
                "change": 1
              }
            },
            {
              "condition": {
                "type": "origins:and",
                "conditions": [
                  {
                    "type": "origins:resource",
                    "resource": "*:*_stealthstate",
                    "comparison": "==",
                    "compare_to": 1
                  },
                  {
                    "type": "origins:or",
                    "conditions": [
                      {
                        "type": "origins:fluid_height",
                        "fluid": "minecraft:water",
                        "comparison": ">",
                        "compare_to": 0
                      },
                      {
                        "type": "origins:in_block_anywhere",
                        "block_condition": {
                          "type": "origins:or",
                          "conditions": [
                            {
                              "type": "origins:in_tag",
                              "tag": "minecraft:crops"
                            },
                            {
                              "type": "origins:in_tag",
                              "tag": "minecraft:flowers"
                            },
                            {
                              "type": "origins:in_tag",
                              "tag": "minecraft:replaceable_by_trees"
                            }
                          ]
                        },
                        "comparison": "==",
                        "compare_to": 0
                      }
                    ]
                  }
                ]
              },
              "action": {
                "type": "origins:change_resource",
                "resource": "*:*_stealthstate",
                "change": -1
              }
            }
          ]
        },
        {
          "type": "origins:if_else_list",
          "actions": [
            {
              "condition": {
                "type": "origins:and",
                "conditions": [
                  {
                    "type": "origins:resource",
                    "resource": "*:faerie/primary_astamina",
                    "comparison": "<",
                    "compare_to": 10
                  },
                  {
                    "type": "origins:on_block"
                  }
                ]
              },
              "action": {
                "type": "origins:change_resource",
                "resource": "*:faerie/primary_astamina",
                "change": 1
              }
            }
          ]
        }
      ]
    }
  },
