        },
        {
          "type": "origins:spawn_particles",
          "particle": {
            "type": "minecraft:smoke"
          },
          "count": 5,
          "speed": 0.1,
          "force": true,
          "offset_y": 1,
          "spread": {
            "x": 0.4,
            "y": 0.25,
            "z": 0.4
          }
        },
        {
          "type": "origins:play_sound",
          "sound": "minecraft:block.stone.hit",
          "volume": 1,
          "pitch": 0.2
        }
      ]
    },
    "key": {
      "key": "key.forward",
      "continuous": true
    }
  },
