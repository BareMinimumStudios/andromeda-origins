{
  "type": "origins:multiple",
  "callback": {
    "type": "origins:action_on_callback",
    "entity_action_added": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:execute_command",
          "command": "title @s actionbar {\"text\": \"You have been constricted! Press direction keys to break free faster!\", \"color\": \"red\"}"
        },
        {
          "type": "origins:grant_power",
          "power": "*:common/restrained",
          "source": "minecraft:ccontrol"
        },
        {
          "type": "origins:change_resource",
          "resource": "*:common/restrained_sources",
          "change": 1
        }
      ]
    },
    "entity_action_lost": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:grant_power",
          "power": "*:gorgon/helper/constrictcd",
          "source": "minecraft:buff"
        },
        {
          "type": "origins:change_resource",
          "resource": "*:common/restrained_sources",
          "change": -1
        }
      ]
    }
  },
  "remove": {
    "type": "origins:resource",
    "min": 0,
    "max": 5,
    "start_value": 5,
    "hud_render": {
      "should_render": false
    },
    "min_action": {
      "type": "origins:revoke_power",
      "power": "*:*",
      "source": "minecraft:ccontrol"
    }
  },
  "timer": {
    "type": "origins:action_over_time",
    "interval": 20,
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:apply_effect",
          "effect": {
            "id": "minecraft:poison",
            "amplifier": 0,
            "duration": 21
          }
        },
        {
          "type": "origins:change_resource",
          "resource": "*:*_remove",
          "change": -1,
          "operation": "add"
        }
      ]
    }
  },
  "visual": {
    "type": "origins:particle",
    "count": 5,
    "particle": "minecraft:happy_villager",
    "spread": {
      "x": 0.25,
      "y": 0.25,
      "z": 0.25
    },
    "offset_y": 1,
    "frequency": 10
  },
  "knockback": {
    "type": "origins:modify_attribute",
    "attribute": "minecraft:generic.knockback_resistance",
    "modifier": {
      "operation": "set_total",
      "amount": 1
    }
  },
  "w_detect": {
    "type": "origins:active_self",
    "cooldown": 20,
    "hud_render": {
      "should_render": false
    },
    "entity_action": {
      "type": "origins:and",
