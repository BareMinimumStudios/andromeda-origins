{
  "type": "origins:multiple",
  "grab": {
    "type": "origins:active_self",
    "cooldown": 5,
    "key": {
      "key": "key.pickItem",
      "continuous": false
    },
    "entity_action": {
      "type": "origins:if_else_list",
      "actions": [
        {
          "condition": {
            "type": "origins:passenger",
            "inverted": true
          },
          "action": {
            "type": "origins:raycast",
            "distance": 4.5,
            "shape_type": "outline",
            "hit_action": {
              "type": "origins:and",
              "actions": [
                {
                  "type": "origins:play_sound",
                  "sound": "entity.bat.takeoff",
                  "volume": 0.33,
                  "pitch": 0.65
                },
                {
                  "type": "origins:swing_hand",
                  "hand": "OFF_HAND"
                },
                {
                  "type": "origins:change_resource",
                  "resource": "andromeda_origins:common/figura_3",
                  "change": 1
                },
                {
                  "type": "origins:grant_power",
                  "power": "*:gorgon/helper/picking",
                  "source": "minecraft:state"
                }
              ]
            },
            "bientity_action": {
              "type": "origins:and",
              "actions": [
                {
                  "type": "origins:invert",
