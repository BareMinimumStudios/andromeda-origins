                  }
                },
                {
                  "type": "origins:actor_action",
                  "action": {
                    "type": "origins:grant_power",
                    "power": "*:gorgon/helper/carry_limit",
                    "source": "minecraft:state"
                  }
                },
                {
                  "type": "origins:target_action",
                  "action": {
                    "type": "origins:execute_command",
                    "command": "tag @s add andromeda_gorgon_grabbed"
                  }
                }
              ]
            },
            "bientity_condition": {
              "type": "origins:target_condition",
              "condition": {
                "type": "origins:and",
                "conditions": [
                  {
                    "type": "origins:living"
                  },
                  {
                    "type": "origins:power",
                    "power": "*:common/unstoppable",
                    "inverted": true
                  },
                  {
                    "type": "origins:power",
                    "power": "*:common/restrained"
                  },
                  {
                    "type": "origins:riding",
                    "inverted": true
                  },
                  {
                    "type": "origins:passenger",
                    "inverted": true
                  }
                ]
              }
            }
          }
        },
        {
          "condition": {
            "type": "origins:passenger"
          },
          "action": {
            "type": "origins:and",
            "actions": [
              {
                "type": "origins:swing_hand",
                "hand": "OFF_HAND"
              },
              {
                "type": "origins:passenger_action",
                "action": {
                  "type": "origins:and",
                  "actions": [
                    {
                      "type": "origins:play_sound",
                      "sound": "entity.ender_dragon.flap",
                      "volume": 0.75,
                      "pitch": 2
                    },
                    {
                      "type": "origins:execute_command",
                      "command": "tag @s remove andromeda_gorgon_grabbed"
                    },
                    {
                      "type": "origins:dismount"
                    },
                    {
                      "type": "origins:add_velocity",
                      "y": 0.66
                    }
                  ]
                },
                "bientity_action": {
                  "type": "origins:add_velocity",
                  "y": -2
                }
              },
              {
                "type": "origins:revoke_power",
                "power": "*:gorgon/helper/carry_limit",
                "source": "minecraft:state"
              }
            ]
          }
        }
      ]
    }
  },
  "kick_rider_out": {
    "type": "origins:active_self",
    "cooldown": 1,
    "hud_render": {
      "should_render": false
    },
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:passenger_action",
          "action": {
            "type": "origins:and",
            "actions": [
              {
                "type": "origins:execute_command",
                "command": "tag @s remove andromeda_gorgon_grabbed"
              },
              {
                "type": "origins:dismount"
              }
            ]
          }
        },
        {
          "type": "origins:revoke_power",
          "power": "*:gorgon/helper/carry_limit",
          "source": "minecraft:state"
        }
      ]
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:sneaking"
        },
        {
          "type": "origins:passenger"
        }
      ]
    },
    "key": {
      "key": "key.jump"
    }
  },
  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/toggle.png",
      "text": [
        "Trigger with ",
        {
          "keybind": "key.pickItem"
        }
      ]
    }
  ],
  "name": "Grab",
  "description": "Press your Pick Item key to grab a §c§l[Restrained]§r creature for up to 10 seconds. Grabbed players cannot dismount themselves. Press Pick Item again to throw the target, or press Sneak + Jump to place it down safely."
}
