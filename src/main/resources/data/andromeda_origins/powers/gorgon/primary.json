    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:power",
          "power": "*:common/silenced",
          "inverted": true
        },
        {
          "type": "origins:resource",
          "comparison": "==",
          "resource": "*:*_petrifycooldown",
          "compare_to": 0
        }
      ]
    },
