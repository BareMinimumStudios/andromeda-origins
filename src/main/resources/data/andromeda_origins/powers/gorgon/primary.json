              "type": "origins:spawn_particles",
              "particle": {
                "type": "minecraft:ash"
              },
              "count": 6,
              "speed": 0.03,
              "force": true,
              "spread": {
                "x": 0.25,
                "y": 0.4,
                "z": 0.25
              },
              "offset_y": 1
            },
            {
              "type": "origins:spawn_particles",
              "particle": {
                "type": "minecraft:witch"
              },
              "count": 5,
              "speed": 0.025,
              "force": true,
              "spread": {
                "x": 0.25,
                "y": 0.4,
                "z": 0.25
              },
              "offset_y": 1
            },
            {
              "type": "origins:spawn_particles",
              "particle": {
                "type": "minecraft:smoke"
              },
              "count": 6,
              "speed": 0.02,
              "force": true,
              "spread": {
                "x": 0.3,
                "y": 0.45,
                "z": 0.3
              },
              "offset_y": 1
            }
          ]
        }
      },
      "bientity_condition": {
        "type": "origins:and",
        "conditions": [
          {
            "type": "origins:can_see"
          },
          {
            "type": "origins:target_condition",
            "condition": {
              "type": "origins:and",
              "conditions": [
                {
                  "type": "origins:living"
                },
                {
                  "type": "origins:power",
                  "power": "*:common/unstoppable",
                  "inverted": true
                },
                {
                  "type": "origins:equipped_item",
                  "equipment_slot": "head",
                  "inverted": true,
                  "item_condition": {
                    "type": "origins:ingredient",
