  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/toggle.png",
      "text": [
        "Trigger with ",
        {
          "keybind": "key.origins.primary_active"
        }
      ]
    },
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/community/silent/badge/colors/red.png",
      "text": "\u00a7c\u00a7lPetrified:\u00a7r\u00a7f For the duration: \u00a7c\u00a7lRestrained\u00a7r\u00a7f, \u00a7c\u00a7lSilenced\u00a7r\u00a7f and \u00a7c\u00a7lPacified\u00a7r\u00a7f. Prevents interaction with the world and knockback, and reduces damage taken by 75%. Affected creatures can \u00a7e\u00a7lStruggle\u00a7r\u00a7f.\n \n\u00a7e\u00a7lStruggle:\u00a7r\u00a7f Rapidly pressing direction keys.\n \n\u00a7c\u00a7lPacified:\u00a7r\u00a7f Unable to deal damage.\n \n\u00a7c\u00a7lRestrained:\u00a7r\u00a7f Prevents movement, movement abilities and elytra flight.\n \n\u00a7c\u00a7lSilenced:\u00a7r\u00a7f Inability to use Active Features."
    }
  ],
  "name": "Ophidian Gaze",
  "description": "Ophidian Gaze has 2 charges. Press your Primary Ability key while looking at a creature within 32 blocks to apply \u00a7c\u00a7l[Petrified]\u00a7r for 10 seconds. Targeting an already Petrified creature extends the effect by another 10 seconds.\n \nThe ability begins recharging after both charges have been spent. \u00a7e\u00a7lCrowd Control\u00a7r."
}
