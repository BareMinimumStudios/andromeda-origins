{
  "type": "origins:multiple",
  "active": {
    "type": "origins:active_self",
    "cooldown": 20,
    "hud_render": {
      "should_render": false
    },
    "entity_action": {
      "type": "origins:raycast",
      "distance": 32,
      "block": false,
      "entity": true,
      "shape_type": "collider",
      "fluid_handling": "none",
      "before_action": {
        "type": "origins:and",
        "actions": [
          {
            "type": "origins:change_resource",
            "resource": "andromeda_origins:common/figura_2",
            "change": 1,
            "operation": "set"
          },
          {
            "type": "origins:delay",
            "ticks": 4,
            "action": {
              "type": "origins:play_sound",
              "sound": "minecraft:entity.illusioner.prepare_mirror",
              "volume": 0.65,
              "pitch": 0.2
            }
          },
          {
            "type": "origins:grant_power",
            "power": "*:gorgon/helper/intimidating",
            "source": "minecraft:state"
          },
          {
            "type": "origins:spawn_particles",
            "particle": {
              "type": "minecraft:ash"
            },
            "count": 6,
            "speed": 0.01,
            "force": true,
            "spread": {
              "x": 0.25,
              "y": 0.45,
              "z": 0.25
            },
            "offset_y": 1
          },
          {
            "type": "origins:delay",
            "ticks": 2,
            "action": {
              "type": "origins:play_sound",
              "sound": "minecraft:block.tuff.break",
              "volume": 0.6,
              "pitch": 0.6
            }
          },
          {
            "type": "origins:spawn_particles",
            "particle": {
              "type": "minecraft:witch"
            },
            "count": 6,
            "speed": 0.025,
            "force": true,
            "spread": {
              "x": 0.25,
              "y": 0.45,
              "z": 0.25
            },
            "offset_y": 1
          },
          {
            "type": "origins:spawn_particles",
            "particle": {
              "type": "minecraft:smoke"
            },
            "count": 5,
            "speed": 0.02,
            "force": true,
            "spread": {
              "x": 0.25,
              "y": 0.4,
              "z": 0.25
            },
            "offset_y": 1
          }
        ]
      },
      "hit_action": {
        "type": "origins:and",
        "actions": [
          {
            "type": "origins:execute_command",
            "command": "andromedaorigins internal_fx gorgon.transference"
          },
          {
            "type": "origins:delay",
            "ticks": 3,
            "action": {
              "type": "origins:play_sound",
              "sound": "minecraft:entity.warden.roar",
              "volume": 0.85,
              "pitch": 1.5
            }
          },
          {
            "type": "origins:change_resource",
            "resource": "*:*_charges",
            "change": -1
          },
          {
            "type": "origins:if_else",
            "condition": {
              "type": "origins:power",
              "power": "*:gorgon/helper/speedup"
            },
            "if_action": {
              "type": "origins:change_resource",
              "resource": "*:gorgon/helper/speedup_remove",
              "change": 15,
              "operation": "set"
            },
            "else_action": {
              "type": "origins:grant_power",
              "power": "*:gorgon/helper/speedup",
              "source": "minecraft:buff"
            }
          },
          {
            "type": "origins:spawn_particles",
            "particle": {
              "type": "minecraft:white_ash"
            },
            "count": 10,
            "speed": 0.03,
            "force": true,
            "spread": {
              "x": 0.35,
              "y": 0.45,
              "z": 0.35
            },
            "offset_y": 1
          }
        ]
      },
      "miss_action": {
        "type": "origins:execute_command",
        "command": "title @s actionbar {\"text\": \"You must target an entity!\", \"color\": \"red\"}"
      },
      "bientity_action": {
        "type": "origins:target_action",
        "action": {
          "type": "origins:and",
          "actions": [
            {
              "type": "origins:execute_command",
              "command": "andromedaorigins internal_fx gorgon.transference_target"
            },
            {
              "type": "origins:delay",
              "ticks": 5,
              "action": {
                "type": "origins:play_sound",
                "sound": "minecraft:entity.rabbit.hurt",
                "volume": 0.7,
                "pitch": 0.4
              }
            },
            {
              "type": "origins:if_else",
              "condition": {
                "type": "origins:power",
                "power": "*:gorgon/helper/intimidated"
              },
              "if_action": {
                "type": "origins:change_resource",
                "resource": "*:gorgon/helper/intimidated_remove",
                "change": 15
              },
              "else_action": {
                "type": "origins:grant_power",
                "power": "*:gorgon/helper/intimidated",
                "source": "minecraft:debuff"
              }
            },
            {
              "type": "origins:delay",
              "ticks": 2,
              "action": {
                "type": "origins:play_sound",
                "sound": "minecraft:block.stone.place",
                "volume": 0.6,
                "pitch": 0.5
              }
            },
            {
              "type": "origins:spawn_particles",
              "particle": {
                "type": "minecraft:ash"
              },
              "count": 6,
              "speed": 0.03,
              "force": true,
              "spread": {
                "x": 0.25,
                "y": 0.4,
                "z": 0.25
              },
              "offset_y": 1
            }
          ]
        }
      },
      "bientity_condition": {
        "type": "origins:and",
        "conditions": [
          {
            "type": "origins:can_see"
          },
          {
            "type": "origins:target_condition",
            "condition": {
              "type": "origins:and",
              "conditions": [
                {
                  "type": "origins:living"
                },
                {
                  "type": "origins:equipped_item",
                  "equipment_slot": "head",
                  "inverted": true,
                  "item_condition": {
                    "type": "origins:ingredient",
                    "ingredient": {
                      "tag": "origins:pumpkin_like/equipment"
                    }
                  }
                }
              ]
            }
          }
        ]
      },
      "command_step": 1,
      "command_along_ray": "particle minecraft:happy_villager",
      "command_along_ray_only_on_hit": true
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:power",
          "power": "*:common/silenced",
          "inverted": true
        },
        {
          "type": "origins:resource",
          "comparison": "==",
          "resource": "*:*_intimidatecooldown",
          "compare_to": 0
        }
      ]
    },
    "key": {
      "key": "key.origins.secondary_active",
      "continuous": false
    }
  },
  "charges": {
    "type": "origins:resource",
    "min": 0,
    "max": 2,
    "start_value": 2,
    "hud_render": {
      "sprite_location": "andromeda_origins:textures/gui/resource_bars_1.png",
      "bar_index": 15,
      "condition": {
        "type": "origins:resource",
        "comparison": "==",
        "resource": "*:*_intimidatecooldown",
        "compare_to": 0
      }
    },
    "min_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:change_resource",
          "resource": "*:*_charges",
          "change": 2
        },
        {
          "type": "origins:trigger_cooldown",
          "power": "*:*_intimidatecooldown"
        }
      ]
    }
  },
  "intimidatecooldown": {
    "type": "origins:cooldown",
    "cooldown": 800,
    "hud_render": {
      "sprite_location": "andromeda_origins:textures/gui/resource_bars_1.png",
      "bar_index": 15,
      "condition": {
        "type": "origins:resource",
        "comparison": ">",
        "resource": "*:*_intimidatecooldown",
        "compare_to": 0
      }
    }
  },
  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/toggle.png",
      "text": [
        "Trigger with ",
        {
          "keybind": "key.origins.secondary_active"
        }
      ]
    }
  ],
  "name": "Transference",
  "description": "Transference has 2 charges. Press your Secondary Ability key while looking at a creature within 32 blocks to reduce its damage dealt by 30% for 15 seconds and double your own movement speed for 15 seconds. Repeated applications can extend the target's damage reduction up to 1 minute."
}
