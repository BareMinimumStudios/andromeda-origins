{
  "type": "origins:multiple",
  "remove": {
    "type": "origins:resource",
    "min": 0,
    "max": 20,
    "start_value": 20,
    "hud_render": {
      "should_render": false
    },
    "min_action": {
      "type": "origins:revoke_power",
      "power": "*:*",
      "source": "minecraft:state"
    }
  },
  "timer": {
    "type": "origins:action_over_time",
    "interval": 1,
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "*:*_remove",
      "change": -1
    }
  },
  "shake": {
    "type": "origins:shaking",
    "condition": {
      "type": "origins:power",
      "power": "andromeda_origins:fenrkin/passives"
    }
  }
}
