            "type": "origins:change_resource",
            "resource": "*:*_leap_chain",
            "change": 0,
            "operation": "set"
          }
        },
        {
          "type": "origins:grant_power",
          "power": "andromeda_origins:common/dash_projectile_penalty",
          "source": "minecraft:state"
        },
        {
          "type": "origins:change_resource",
          "resource": "andromeda_origins:common/dash_projectile_penalty_remove",
          "change": 3,
          "operation": "set"
        },
        {
          "type": "origins:change_resource",
          "resource": "*:*_astamina",
          "change": -10
        },
        {
          "type": "origins:play_sound",
          "sound": "item.armor.equip_leather",
          "volume": 2,
          "pitch": 0.7
        },
        {
          "type": "origins:spawn_particles",
          "particle": {
            "type": "minecraft:cloud"
          },
          "count": 6,
          "speed": 0.5,
          "force": true,
          "offset_y": 0,
          "spread": {
            "x": 0.1,
            "y": 0,
            "z": 0.1
          }
        },
        {
          "type": "origins:add_velocity",
          "y": 0.3,
          "space": "world",
          "set": false
        },
        {
          "type": "origins:add_velocity",
          "z": 1.5,
          "space": "local_horizontal_normalized",
          "set": false
        },
        {
          "type": "origins:set_fall_distance",
          "fall_distance": 0
        },
        {
          "type": "origins:change_resource",
          "resource": "*:common/figura_5",
          "change": 1,
          "operation": "set"
        },
        {
          "type": "origins:grant_power",
          "power": "*:fenrkin/helper/pouncing",
          "source": "minecraft:state"
        }
      ]
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:power",
          "power": "*:common/silenced",
          "inverted": true
        },
        {
          "type": "origins:power",
          "power": "*:common/restrained",
          "inverted": true
        },
        {
          "type": "origins:fluid_height",
          "fluid": "minecraft:lava",
          "comparison": "==",
          "compare_to": 0
        },
        {
          "type": "origins:fluid_height",
          "fluid": "minecraft:water",
          "comparison": "==",
          "compare_to": 0
        },
        {
          "type": "origins:or",
          "conditions": [
            {
              "type": "origins:resource",
              "resource": "*:*_astamina",
              "comparison": ">=",
              "compare_to": 10
            },
            {
              "type": "origins:and",
              "conditions": [
                {
                  "type": "origins:resource",
                  "resource": "*:*_leap_chain",
                  "comparison": ">",
                  "compare_to": 0
                },
                {
                  "type": "origins:resource",
                  "resource": "*:*_astamina",
                  "comparison": ">",
                  "compare_to": 0
                }
              ]
            }
          ]
        },
        {
          "type": "origins:resource",
          "resource": "*:*_breathlock",
          "comparison": "==",
          "compare_to": 0
        },
        {
          "type": "origins:resource",
          "resource": "*:*_surge_hold",
          "comparison": ">",
          "compare_to": 0
        },
        {
          "type": "origins:resource",
          "resource": "*:common/figura_5",
          "comparison": "==",
          "compare_to": 0
        }
      ]
    },
    "key": {
      "key": "key.jump",
      "continuous": false
    }
  },
  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/toggle.png",
      "text": [
        "Trigger with ",
        {
          "keybind": "key.origins.secondary_active"
        }
      ]
    }
  ],
  "name": "Stamina Surge",
  "description": "Stamina regenerates while this ability is not in use. Hold your Secondary Ability key to double your movement speed at the cost of 1 Stamina per second. While holding Stamina Surge on land, press Jump to perform a powerful leap. A leap normally costs 50% of your maximum Stamina; after a near-full first leap, a brief follow-up window lets a second leap spend the remaining Stamina even if sprinting drained a small amount between jumps.\n \nYour projectile damage is reduced by 50% while using Stamina Surge and for 3 seconds afterward. §e§lMovement Ability§r."
}
