                "conditions": [
                  {
                    "type": "origins:resource",
                    "resource": "*:*_weaknesstate2",
                    "comparison": "==",
                    "compare_to": 1
                  },
                  {
                    "type": "origins:block_collision",
                    "offset_x": 0,
                    "offset_y": 1,
