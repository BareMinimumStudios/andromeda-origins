  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/community/silent/badge/shapes/shape_heart.png",
      "text": "\u00a7e\u00a7lDamage Resistances:\u00a7r\u00a7f All sources (-25%).\n \n\u00a7c\u00a7lDamage Vulnerabilities:\u00a7r\u00a7f None.\n \n\u00a7e\u00a7lEffect Immunities:\u00a7r\u00a7f None."
    }
