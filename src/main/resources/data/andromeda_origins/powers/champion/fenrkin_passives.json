  "heart": {
    "type": "origins:action_over_time",
    "interval": 20,
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:if_else_list",
          "actions": [
            {
              "condition": {
                "type": "origins:and",
                "conditions": [
                  {
                    "type": "origins:resource",
                    "resource": "*:fenrkin/secondary_astamina",
                    "comparison": "<",
                    "compare_to": 20
                  },
                  {
                    "type": "origins:resource",
                    "resource": "*:common/figura_3",
                    "comparison": "==",
                    "compare_to": 0
                  }
                ]
              },
              "action": {
                "type": "origins:change_resource",
                "resource": "*:fenrkin/secondary_astamina",
                "change": 1
              }
            }
          ]
        }
      ]
    }
  },
