  "heart": {
    "type": "origins:action_over_time",
    "interval": 20,
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:if_else_list",
          "actions": [
            {
              "condition": {
                "type": "origins:and",
                "conditions": [
                  {
                    "type": "origins:resource",
                    "resource": "*:fenrkin/secondary_astamina",
                    "comparison": "<",
                    "compare_to": 20
                  },
                  {
                    "type": "origins:resource",
                    "resource": "*:common/figura_3",
                    "comparison": "==",
                    "compare_to": 0
                  }
                ]
              },
              "action": {
                "type": "origins:change_resource",
                "resource": "*:fenrkin/secondary_astamina",
                "change": 1
              }
            }
          ]
        }
      ]
    }
  },
  "resistances": {
    "type": "origins:modify_damage_taken",
    "modifier": {
      "operation": "multiply_total_multiplicative",
      "amount": -0.25
    }
  },
  "toggle_state": {
    "type": "origins:resource",
    "min": 0,
    "max": 1,
    "start_value": 1,
    "hud_render": {
      "should_render": false
    }
  },
  "toggle_action": {
    "type": "origins:active_self",
    "cooldown": 1,
    "hud_render": {
      "should_render": false
    },
    "entity_action": {
      "type": "origins:if_else",
      "condition": {
        "type": "origins:resource",
        "resource": "*:*_toggle_state",
        "comparison": "==",
        "compare_to": 0
      },
      "if_action": {
        "type": "origins:change_resource",
        "resource": "*:*_toggle_state",
        "change": 1,
        "operation": "set"
      },
      "else_action": {
        "type": "origins:change_resource",
        "resource": "*:*_toggle_state",
        "change": 0,
        "operation": "set"
      }
    },
    "key": {
      "key": "key.andromeda_origins.toggle",
      "continuous": false
    }
  },
  "darkvision": {
    "type": "origins:night_vision",
    "strength": 0.75,
    "condition": {
      "type": "origins:resource",
      "resource": "*:*_toggle_state",
      "comparison": "==",
      "compare_to": 1
    }
  },
  "speedup": {
    "type": "origins:attribute",
    "modifier": {
      "id": "andromeda_origins:champion_fenrkin_passives_speedup",
      "attribute": "minecraft:generic.movement_speed",
      "operation": "add_multiplied_total",
      "amount": 0.2
    }
  },
  "undercooldown": {
    "type": "origins:cooldown",
    "cooldown": 7200,
    "hud_render": {
      "sprite_location": "andromeda_origins:textures/gui/resource_bars_1.png",
      "bar_index": 13
    }
  },
  "underdog": {
    "type": "origins:prevent_death",
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:play_sound",
          "sound": "minecraft:entity.wolf.howl",
          "volume": 1,
          "pitch": 0.7
        },
        {
          "type": "origins:execute_command",
          "command": "andromedaorigins internal_fx fenrkin.adrenaline"
        },
        {
          "type": "origins:extinguish"
        },
        {
          "type": "origins:trigger_cooldown",
          "power": "*:*_undercooldown"
        },
        {
          "type": "origins:delay",
          "ticks": 1,
          "action": {
            "type": "origins:execute_command",
            "command": "andromedaorigins internal_set_health_8"
          }
        },
        {
          "type": "origins:change_resource",
          "resource": "*:common/figura_4",
          "change": 1,
          "operation": "set"
        },
        {
          "type": "origins:grant_power",
          "power": "*:common/resistance",
          "source": "minecraft:buff"
        },
        {
          "type": "origins:grant_power",
          "power": "*:fenrkin/helper/unstoppable_anim",
          "source": "minecraft:buff"
        },
        {
          "type": "origins:grant_power",
          "power": "*:common/unstoppable",
          "source": "minecraft:buff"
        },
        {
          "type": "origins:revoke_all_powers",
          "source": "minecraft:ccontrol"
        }
      ]
    },
    "condition": {
      "type": "origins:resource",
      "resource": "*:*_undercooldown",
      "comparison": "==",
      "compare_to": 0
    }
  },
  "size": {
    "type": "origins:attribute",
    "modifier": {
      "id": "andromeda_origins:champion_fenrkin_passives_size",
      "attribute": "minecraft:generic.scale",
      "operation": "add_multiplied_total",
      "amount": 0.2
    }
  },
  "step_assist": {
    "type": "origins:conditioned_attribute",
    "tick_rate": 1,
    "modifier": {
      "id": "andromeda_origins:champion_fenrkin_passives_step_assist",
      "attribute": "minecraft:generic.step_height",
      "operation": "add_multiplied_total",
      "amount": 1.0
    },
    "condition": {
      "type": "origins:resource",
      "resource": "*:*_toggle_state",
      "comparison": "==",
      "compare_to": 1
    }
  },
  "name": "Champion Passive Features",
  "description": "\u00a7e\u00a7lChampion Features:\u00a7r\n+20% Size\n+20% Movement Speed\n-25% Damage Taken from all sources\n \n- Retains darkvision, hunting abilities, Stamina Surge and Adrenaline. Adrenaline restores you to 8 health, breaks Crowd Control, briefly makes you Unstoppable, and grants its 35-second resistance buff. Its base cooldown is 6 minutes (3 minutes effective with Champion cooldown recovery).\n- Mark of Fenrir retains its mark/reveal and +25% damage interaction without the stalking movement penalty.\n- No Wet, cramped-space, armor-Wither or dietary penalties.\n- Player-facing ability cooldowns recover at 2\u00d7 rate (50% shorter); charge times, resource costs, and internal ability cadence are unchanged."
}
