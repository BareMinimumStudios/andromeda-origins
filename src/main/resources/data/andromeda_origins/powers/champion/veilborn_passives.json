{
  "type": "origins:multiple",
  "callback": {
    "type": "origins:action_on_callback",
    "entity_action_chosen": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:change_resource",
          "resource": "andromeda_origins:champion/veilborn_passives_daytime",
          "change": 0,
          "operation": "set"
        },
        {
          "type": "origins:change_resource",
          "resource": "andromeda_origins:veilborn/primary_active",
          "change": 0,
          "operation": "set"
        },
        {
          "type": "origins:change_resource",
          "resource": "andromeda_origins:veilborn/primary_active3",
          "change": 0,
          "operation": "set"
        },
        {
          "type": "origins:change_resource",
          "resource": "andromeda_origins:veilborn/secondary_unstoppable",
          "change": 0,
          "operation": "set"
        },
        {
          "type": "origins:change_resource",
          "resource": "andromeda_origins:veilborn/secondary_cooldown",
          "change": 0,
          "operation": "set"
        },
        {
          "type": "origins:change_resource",
          "resource": "andromeda_origins:veilborn/secondary_uncloak",
          "change": 0,
          "operation": "set"
        },
        {
          "type": "andromeda_origins:tag",
          "tag": "veilborn",
          "operation": "add"
        }
      ]
    },
    "entity_action_lost": {
      "type": "origins:and",
      "actions": [
        {
          "type": "andromeda_origins:tag",
          "tag": "veilborn",
          "operation": "remove"
        },
        {
          "type": "andromeda_origins:cleanup_origin_state",
          "origin": "veilborn"
        }
      ]
    },
    "execute_chosen_when_orb": true
  },
  "daytime": {
    "type": "origins:resource",
    "min": 0,
    "max": 1,
    "start_value": 0,
    "hud_render": {
      "should_render": false
    }
  },
  "heart": {
    "type": "origins:action_over_time",
    "interval": 20,
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:if_else_list",
          "actions": [
            {
              "condition": {
                "type": "origins:and",
                "conditions": [
                  {
                    "type": "origins:resource",
                    "resource": "*:*_daytime",
                    "comparison": "==",
                    "compare_to": 0
                  },
                  {
                    "type": "origins:exposed_to_sun"
                  }
                ]
              },
              "action": {
                "type": "origins:and",
                "actions": [
                  {
                    "type": "origins:change_resource",
                    "resource": "*:*_daytime",
                    "change": 1
                  },
                  {
                    "type": "origins:grant_power",
                    "power": "*:veilborn/helper/daypower",
                    "source": "minecraft:state"
                  },
                  {
                    "type": "origins:revoke_power",
                    "power": "*:veilborn/helper/nightpower",
                    "source": "minecraft:state"
                  }
                ]
              }
            },
            {
              "condition": {
                "type": "origins:and",
                "conditions": [
                  {
                    "type": "origins:resource",
                    "resource": "*:*_daytime",
                    "comparison": "==",
                    "compare_to": 1
                  },
                  {
                    "type": "origins:exposed_to_sun",
                    "inverted": true
                  },
                  {
                    "type": "origins:exposed_to_sky"
                  },
                  {
                    "type": "origins:in_rain",
                    "inverted": true
                  }
                ]
              },
              "action": {
                "type": "origins:and",
                "actions": [
                  {
                    "type": "origins:change_resource",
                    "resource": "*:*_daytime",
                    "change": -1
                  },
                  {
                    "type": "origins:revoke_power",
                    "power": "*:veilborn/helper/daypower",
                    "source": "minecraft:state"
                  },
                  {
                    "type": "origins:grant_power",
                    "power": "*:veilborn/helper/nightpower",
                    "source": "minecraft:state"
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  },
  "toggle": {
    "type": "origins:toggle",
    "key": {
      "key": "key.andromeda_origins.toggle",
      "continuous": false
    }
  },
  "translucent": {
    "type": "origins:model_color",
    "alpha": 0.6,
    "condition": {
      "type": "origins:power_active",
      "power": "*:*_toggle"
    }
  },
  "size": {
    "type": "origins:attribute",
    "modifier": {
      "id": "andromeda_origins:champion_veilborn_passives_size",
      "attribute": "minecraft:generic.scale",
      "operation": "multiply_total_multiplicative",
      "amount": 0.2
    }
  },
  "name": "Champion Passive Features",
  "description": "§e§lChampion Features:§r\n+20% Size\n \n- Retains sunlight speed, moonlight damage, translucency, Shimmer and veil powers.\n- No health, armor-weight, shield, or water-weakness penalties.\n- Veil Step does not self-apply Reality Shatter after emerging; crossed living entities are still shattered. Veil Transposition still applies Reality Shatter to its target.\n- Entering or leaving Auroral Mirage releases an 8-block Darkness burst, applying Darkness to nearby entities for 5 seconds.\n- Auroral Mirage has a fixed 5-second cooldown. Other player-facing ability cooldowns recover at 2× rate (50% shorter); charge times, resource costs, and internal ability cadence are unchanged."
}
