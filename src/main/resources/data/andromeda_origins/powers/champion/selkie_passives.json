{
  "type": "origins:multiple",
  "callback": {
    "type": "origins:action_on_callback",
    "entity_action_chosen": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:change_resource",
          "resource": "andromeda_origins:selkie/primary_active",
          "change": 0,
          "operation": "set"
        },
        {
          "type": "origins:change_resource",
          "resource": "andromeda_origins:selkie/primary_active2",
          "change": 0,
          "operation": "set"
        },
        {
          "type": "origins:change_resource",
          "resource": "andromeda_origins:selkie/secondary_active",
          "change": 0,
          "operation": "set"
        },
        {
          "type": "andromeda_origins:tag",
          "tag": "selkie",
          "operation": "add"
        },
        {
          "type": "origins:grant_power",
          "power": "*:selkie/helper/merlingplus",
          "source": "minecraft:state"
        }
      ]
    },
    "entity_action_lost": {
      "type": "origins:and",
      "actions": [
        {
          "type": "andromeda_origins:tag",
          "tag": "selkie",
          "operation": "remove"
        },
        {
          "type": "origins:revoke_power",
          "power": "*:selkie/helper/selkiewet",
          "source": "minecraft:debuff"
        },
        {
          "type": "origins:revoke_power",
          "power": "*:selkie/helper/groundweak",
          "source": "minecraft:state"
        },
        {
          "type": "origins:grant_power",
          "power": "*:selkie/helper/merlingminus",
          "source": "minecraft:state"
        },
        {
          "type": "andromeda_origins:cleanup_origin_state",
          "origin": "selkie"
        }
      ]
    },
    "execute_chosen_when_orb": true
  },
  "creature_type": {
    "type": "origins:modify_type_tag",
    "tag": "aquatic"
  },
  "waterspeed": {
    "type": "origins:attribute",
    "modifier": {
      "id": "andromeda_origins:champion_selkie_passives_waterspeed",
      "attribute": "additionalentityattributes:generic.water_speed",
      "operation": "multiply_total_multiplicative",
      "amount": 0.45
    }
  },
  "toggle": {
    "type": "origins:toggle",
    "key": {
      "key": "key.andromeda_origins.toggle",
      "continuous": false
    }
  },
  "darkvision": {
    "type": "origins:night_vision",
    "strength": 0.75,
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:submerged_in",
          "fluid": "minecraft:water"
        },
        {
          "type": "origins:power_active",
          "power": "*:*_toggle"
        }
      ]
    }
  },
  "water_vision": {
    "type": "origins:modify_camera_submersion",
    "from": "water",
    "to": "none",
    "condition": {
      "type": "origins:power_active",
      "power": "*:*_toggle"
    }
  },
  "when_hit": {
    "type": "origins:action_when_hit",
    "bientity_action": {
      "type": "origins:actor_action",
      "action": {
        "type": "origins:grant_power",
        "power": "*:selkie/helper/retaliated",
        "source": "minecraft:debuff"
      }
    }
  },
  "name": "Champion Passive Features",
  "description": "§e§lChampion Features:§r\n+45% Swim Speed\n \n- Retains aquatic movement, retaliation, underwater vision and land breathing.\n- No dry-out, Silenced, land-speed, damage or dietary penalties.\n- Player-facing ability cooldowns recover at 2× rate (50% shorter); charge times, resource costs, and internal ability cadence are unchanged."
}
