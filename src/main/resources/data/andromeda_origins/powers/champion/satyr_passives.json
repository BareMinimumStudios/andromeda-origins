        {
          "type": "origins:spawn_particles",
          "particle": {
            "type": "minecraft:gust_emitter_small"
          },
          "count": 1,
          "speed": 0.0,
          "force": true,
          "offset_y": 0.1,
          "spread": {
            "x": 0,
            "y": 0,
            "z": 0
          }
        },
        {
          "type": "origins:add_velocity",
          "y": 0.8,
          "space": "world",
          "set": false
        },
        {
          "type": "origins:add_velocity",
          "z": 0.4,
          "space": "local_horizontal_normalized",
          "set": false
        }
      ]
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
