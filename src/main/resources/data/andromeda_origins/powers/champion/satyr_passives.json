{
  "type": "origins:multiple",
  "callback": {
    "type": "origins:action_on_callback",
    "entity_action_chosen": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:change_resource",
          "resource": "andromeda_origins:champion/satyr_passives_sprintmeter",
          "change": 0,
          "operation": "set"
        },
        {
          "type": "origins:change_resource",
          "resource": "andromeda_origins:champion/satyr_passives_jumps",
          "change": 1,
          "operation": "set"
        },
        {
          "type": "origins:change_resource",
          "resource": "andromeda_origins:champion/satyr_passives_bigjump",
          "change": 5,
          "operation": "set"
        },
        {
          "type": "origins:change_resource",
          "resource": "andromeda_origins:champion/satyr_passives_stompcd",
          "change": 60,
          "operation": "set"
        },
        {
          "type": "origins:change_resource",
          "resource": "andromeda_origins:champion/satyr_passives_stomp",
          "change": 10,
          "operation": "set"
        },
        {
          "type": "origins:change_resource",
          "resource": "andromeda_origins:satyr/primary_active",
          "change": 200,
          "operation": "set"
        },
        {
          "type": "origins:change_resource",
          "resource": "andromeda_origins:satyr/secondary_blocker",
          "change": 1,
          "operation": "set"
        },
        {
          "type": "origins:change_resource",
          "resource": "andromeda_origins:satyr/secondary_active",
          "change": 10,
          "operation": "set"
        },
        {
          "type": "origins:execute_command",
          "command": "tag @s add satyr"
        }
      ]
    },
    "entity_action_lost": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:execute_command",
          "command": "tag @s remove satyr"
        },
        {
          "type": "origins:grant_power",
          "power": "*:common/debug",
          "source": "minecraft:state"
        }
      ]
    },
    "execute_chosen_when_orb": true
  },
  "sprintmeter": {
    "type": "origins:resource",
    "min": 0,
    "max": 5,
    "start_value": 0,
    "hud_render": {
      "should_render": true,
      "sprite_location": "andromeda_origins:textures/gui/resource_bars_1.png",
      "bar_index": 0
    },
    "max_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:play_sound",
          "sound": "entity.wind_charge.wind_burst",
          "volume": 0.8,
          "pitch": 1.6
        },
        {
          "type": "origins:spawn_particles",
          "particle": {
            "type": "minecraft:flash"
          },
          "count": 1,
          "speed": 0.0,
          "force": true,
          "offset_y": 1,
          "spread": {
            "x": 0,
            "y": 0,
            "z": 0
          }
        },
        {
          "type": "origins:change_resource",
          "resource": "*:common/figura_1",
          "change": 1,
          "operation": "set"
        }
      ]
    }
  },
  "heart": {
    "type": "origins:action_over_time",
    "interval": 20,
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:if_else_list",
          "actions": [
            {
              "condition": {
                "type": "origins:and",
                "conditions": [
                  {
                    "type": "origins:resource",
                    "resource": "*:*_sprintmeter",
                    "comparison": "<",
                    "compare_to": 5
                  },
                  {
                    "type": "origins:sprinting"
                  },
                  {
                    "type": "origins:power_active",
                    "power": "*:*_toggle"
                  }
                ]
              },
              "action": {
                "type": "origins:and",
                "actions": [
                  {
                    "type": "origins:change_resource",
                    "resource": "*:*_sprintmeter",
                    "change": 1
                  },
                  {
                    "type": "origins:if_else_list",
                    "actions": [
                      {
                        "condition": {
                          "type": "origins:resource",
                          "resource": "*:*_sprintmeter",
                          "comparison": "==",
                          "compare_to": 1
                        },
                        "action": {
                          "type": "origins:grant_power",
                          "power": "*:satyr/helper/rushing",
                          "source": "minecraft:state"
                        }
                      },
                      {
                        "condition": {
                          "type": "origins:resource",
                          "resource": "*:*_sprintmeter",
                          "comparison": "==",
                          "compare_to": 2
                        },
                        "action": {
                          "type": "origins:grant_power",
                          "power": "*:satyr/helper/rushing2",
                          "source": "minecraft:state"
                        }
                      },
                      {
                        "condition": {
                          "type": "origins:resource",
                          "resource": "*:*_sprintmeter",
                          "comparison": "==",
                          "compare_to": 3
                        },
                        "action": {
                          "type": "origins:grant_power",
                          "power": "*:satyr/helper/rushing3",
                          "source": "minecraft:state"
                        }
                      },
                      {
                        "condition": {
                          "type": "origins:resource",
                          "resource": "*:*_sprintmeter",
                          "comparison": "==",
                          "compare_to": 4
                        },
                        "action": {
                          "type": "origins:grant_power",
                          "power": "*:satyr/helper/rushing4",
                          "source": "minecraft:state"
                        }
                      },
                      {
                        "condition": {
                          "type": "origins:resource",
                          "resource": "*:*_sprintmeter",
                          "comparison": "==",
                          "compare_to": 5
                        },
                        "action": {
                          "type": "origins:grant_power",
                          "power": "*:satyr/helper/rushing5",
                          "source": "minecraft:state"
                        }
                      }
                    ]
                  }
                ]
              }
            },
            {
              "condition": {
                "type": "origins:and",
                "conditions": [
                  {
                    "type": "origins:resource",
                    "resource": "*:*_sprintmeter",
                    "comparison": ">",
                    "compare_to": 0
                  },
                  {
                    "type": "origins:or",
                    "conditions": [
                      {
                        "type": "origins:sprinting",
                        "inverted": true
                      },
                      {
                        "type": "origins:power_active",
                        "power": "*:*_toggle",
                        "inverted": true
                      }
                    ]
                  }
                ]
              },
              "action": {
                "type": "origins:and",
                "actions": [
                  {
                    "type": "origins:change_resource",
                    "resource": "*:*_sprintmeter",
                    "change": -1
                  },
                  {
                    "type": "origins:if_else_list",
                    "actions": [
                      {
                        "condition": {
                          "type": "origins:resource",
                          "resource": "*:*_sprintmeter",
                          "comparison": "==",
                          "compare_to": 4
                        },
                        "action": {
                          "type": "origins:and",
                          "actions": [
                            {
                              "type": "origins:revoke_power",
                              "power": "*:satyr/helper/rushing5",
                              "source": "minecraft:state"
                            },
                            {
                              "type": "origins:change_resource",
                              "resource": "*:common/figura_1",
                              "change": 0,
                              "operation": "set"
                            }
                          ]
                        }
                      },
                      {
                        "condition": {
                          "type": "origins:resource",
                          "resource": "*:*_sprintmeter",
                          "comparison": "==",
                          "compare_to": 3
                        },
                        "action": {
                          "type": "origins:revoke_power",
                          "power": "*:satyr/helper/rushing4",
                          "source": "minecraft:state"
                        }
                      },
                      {
                        "condition": {
                          "type": "origins:resource",
                          "resource": "*:*_sprintmeter",
                          "comparison": "==",
                          "compare_to": 2
                        },
                        "action": {
                          "type": "origins:revoke_power",
                          "power": "*:satyr/helper/rushing3",
                          "source": "minecraft:state"
                        }
                      },
                      {
                        "condition": {
                          "type": "origins:resource",
                          "resource": "*:*_sprintmeter",
                          "comparison": "==",
                          "compare_to": 1
                        },
                        "action": {
                          "type": "origins:revoke_power",
                          "power": "*:satyr/helper/rushing2",
                          "source": "minecraft:state"
                        }
                      },
                      {
                        "condition": {
                          "type": "origins:resource",
                          "resource": "*:*_sprintmeter",
                          "comparison": "==",
                          "compare_to": 0
                        },
                        "action": {
                          "type": "origins:revoke_power",
                          "power": "*:satyr/helper/rushing",
                          "source": "minecraft:state"
                        }
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  },
