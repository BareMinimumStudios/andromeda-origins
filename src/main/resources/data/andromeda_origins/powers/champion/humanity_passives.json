{
  "type": "origins:multiple",
  "callback": {
    "type": "origins:action_on_callback",
    "entity_action_chosen": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:change_resource",
          "resource": "andromeda_origins:humanity/primary_active",
          "change": 0,
          "operation": "set"
        },
        {
          "type": "andromeda_origins:tag",
          "tag": "human",
          "operation": "add"
        }
      ]
    },
    "entity_action_lost": {
      "type": "origins:and",
      "actions": [
        {
          "type": "andromeda_origins:stop_champion_mortal_resolve"
        },
        {
          "type": "andromeda_origins:tag",
          "tag": "human",
          "operation": "remove"
        },
        {
          "type": "andromeda_origins:cleanup_origin_state",
          "origin": "humanity"
        }
      ]
    },
    "execute_chosen_when_orb": true
  },
  "name": "Champion Passive Features",
  "description": "§e§lChampion Features:§r\n- Champion Humanity has normal health and hunger efficiency.\n- Mortal Resolve becomes a victorious final effort rather than a forced death.\n- Player-facing ability cooldowns recover at 2× rate (50% shorter); charge times, resource costs, and internal ability cadence are unchanged."
}
