      "source": "minecraft:debuff"
    },
    "condition": {
      "type": "origins:fall_distance",
      "comparison": ">",
      "compare_to": 0
    }
  },
  "undeadinfluence": {
    "type": "origins:target_action_on_hit",
    "cooldown": 0,
    "hud_render": {
      "should_render": false
    },
    "entity_action": {
      "type": "origins:area_of_effect",
      "radius": 16,
      "shape": "sphere",
      "bientity_action": {
        "type": "origins:damage",
        "damage_type": "minecraft:cramming",
        "amount": 0
      },
      "bientity_condition": {
        "type": "origins:and",
        "conditions": [
          {
            "type": "origins:can_see"
          },
          {
            "type": "origins:target_condition",
            "condition": {
              "type": "origins:and",
              "conditions": [
                {
                  "type": "origins:living"
                },
                {
                  "type": "origins:in_tag",
                  "tag": "minecraft:undead"
                }
              ]
            }
          }
        ]
      }
    },
    "condition": {
      "type": "origins:power_active",
      "power": "*:*_toggle"
    }
