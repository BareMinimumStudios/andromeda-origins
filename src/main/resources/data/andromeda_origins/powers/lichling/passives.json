  "weaknesstate": {
    "type": "origins:resource",
    "min": 0,
    "max": 1,
    "start_value": 0,
    "hud_render": {
      "should_render": true,
      "sprite_location": "origins:textures/gui/community/huang/resource_bar_02.png",
      "bar_index": 14,
      "order": 6,
      "condition": {
        "type": "origins:resource",
        "resource": "*:*_weaknesstate",
        "comparison": ">",
        "compare_to": 0
      }
    },
    "max_action": {
      "type": "origins:grant_power",
      "power": "*:lichling/helper/sunweak",
      "source": "minecraft:state"
    },
    "min_action": {
      "type": "origins:revoke_power",
      "power": "*:lichling/helper/sunweak",
      "source": "minecraft:state"
    }
  },
  "heart": {
    "type": "origins:action_over_time",
    "interval": 20,
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:if_else_list",
          "actions": [
            {
              "condition": {
                "type": "origins:and",
                "conditions": [
                  {
                    "type": "origins:resource",
                    "resource": "*:*_weaknesstate",
                    "comparison": "==",
                    "compare_to": 0
                  },
                  {
                    "type": "origins:exposed_to_sun"
                  }
                ]
              },
              "action": {
                "type": "origins:change_resource",
                "resource": "*:*_weaknesstate",
                "change": 1
              }
            },
            {
              "condition": {
                "type": "origins:and",
                "conditions": [
                  {
                    "type": "origins:resource",
                    "resource": "*:*_weaknesstate",
                    "comparison": "==",
                    "compare_to": 1
                  },
                  {
                    "type": "origins:exposed_to_sun",
                    "inverted": true
                  }
                ]
              },
              "action": {
                "type": "origins:change_resource",
                "resource": "*:*_weaknesstate",
                "change": -1
              }
            }
          ]
        },
        {
          "type": "origins:if_else_list",
          "actions": [
            {
              "condition": {
                "type": "origins:and",
                "conditions": [
                  {
                    "type": "origins:resource",
                    "resource": "*:lichling/secondary_astamina",
                    "comparison": "<",
                    "compare_to": 10
                  },
                  {
                    "type": "origins:resource",
                    "resource": "*:common/figura_3",
                    "comparison": "==",
                    "compare_to": 0
                  }
                ]
              },
              "action": {
                "type": "origins:chance",
                "action": {
                  "type": "origins:change_resource",
                  "resource": "*:lichling/secondary_astamina",
                  "change": 1
                },
                "chance": 0.1
              }
            }
          ]
        }
      ]
    }
  },
  "creature_type": {
    "type": "origins:modify_type_tag",
    "tag": "undead"
  },
  "effect_immunities": {
    "type": "origins:effect_immunity",
    "effects": [
      "minecraft:slowness",
      "minecraft:weakness",
      "minecraft:mining_fatigue",
      "minecraft:nausea",
      "minecraft:darkness",
      "minecraft:blindness"
    ]
  },
  "toggle": {
    "type": "origins:toggle",
    "key": {
      "key": "key.andromeda_origins.toggle",
      "continuous": false
    }
  },
  "hp": {
    "type": "origins:attribute",
    "modifier": {
      "id": "*:*",
      "attribute": "minecraft:generic.max_health",
      "operation": "add_value",
      "amount": 8
    }
  },
  "exhaustion": {
    "type": "origins:modify_exhaustion",
    "modifier": {
      "operation": "multiply_total_multiplicative",
      "amount": -0.35
    }
  },
  "flammable": {
    "type": "origins:self_action_when_hit",
