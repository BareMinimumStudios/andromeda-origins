  },
  "good_digestion": {
    "type": "origins:modify_food",
    "food_modifier": {
      "operation": "multiply_total_multiplicative",
      "amount": 3
    },
    "saturation_modifier": {
      "operation": "multiply_total_multiplicative",
      "amount": 3
    }
  },
  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/community/silent/badge/shapes/shape_heart.png",
      "text": "§e§lDamage Resistances:§r§f None.\n \n§c§lDamage Vulnerabilities:§r§f Iron weapons (+20%).\n \n§e§lEffect Immunities:§r§f Poison, Regeneration, Slowness, Weakness, Mining Fatigue, Nausea, Darkness, and Blindness. Instant Damage and Instant Healing are inverted."
    },
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/community/silent/badge/colors/red.png",
      "text": "§c§lWet:§r§f Counts as being in water."
    }
  ],
  "name": "Passive Features",
  "description": "§e§lStats:§r\n+8 Max HP\n-35% Hunger Drain\n \n§e§lFeatures:§r\n- Your creature type is Undead.\n- Hitting a creature while falling reduces its damage dealt by 20% for 10 seconds.\n- Killing a creature restores 2 Hunger and 4 Saturation.\n- When you strike a creature, nearby unoccupied Undead within 16 blocks are compelled to attack it. Toggleable.\n- Carrying or wearing any iron-tagged item anywhere in your inventory applies Wither I. Iron weapons also deal 20% more damage to you and apply Wither I on hit.\n- Sunlight reduces your movement speed and damage dealt by 35%.\n- Fire does not extinguish on its own.\n- You can only eat raw foods; valid foods are four times as effective."
}
