{
  "type": "origins:multiple",
  "remove": {
    "type": "origins:resource",
    "min": 0,
    "max": 10,
    "start_value": 10,
    "hud_render": {
      "should_render": false
    },
    "min_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:change_resource",
          "resource": "andromeda_origins:common/figura_1",
          "change": -1,
          "operation": "add"
        },
        {
          "type": "origins:revoke_power",
          "power": "*:*",
          "source": "minecraft:state"
        }
      ]
    }
  },
  "timer": {
    "type": "origins:action_over_time",
    "interval": 1,
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:spawn_particles",
          "particle": {
            "type": "minecraft:spit"
          },
          "count": 1,
          "speed": 0.0,
          "force": true,
          "offset_y": 1,
          "spread": {
            "x": 0.1,
            "y": 0,
            "z": 0.1
          }
        },
        {
          "type": "origins:change_resource",
          "resource": "*:*_remove",
          "change": -1,
          "operation": "add"
        },
        {
          "type": "origins:add_velocity",
          "z": 3,
          "y": -2,
          "space": "local_horizontal",
          "set": true
        },
        {
          "type": "origins:if_else_list",
          "actions": [
            {
              "condition": {
                "type": "origins:resource",
                "comparison": "==",
                "resource": "*:*_sounds",
                "compare_to": 0
              },
              "action": {
                "type": "origins:and",
                "actions": [
                  {
                    "type": "origins:play_sound",
                    "sound": "minecraft:entity.spider.step",
                    "volume": 0.5,
                    "pitch": 0.8
                  },
                  {
                    "type": "origins:trigger_cooldown",
                    "power": "*:*_sounds"
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  },
  "sounds": {
    "type": "origins:cooldown",
    "cooldown": 7,
    "hud_render": {
      "should_render": false
    }
  },
  "gravity_up": {
    "type": "origins:modify_falling",
    "velocity": 0,
    "take_fall_damage": false
  },
  "overlay": {
    "type": "origins:overlay",
    "hidden": true,
    "sprite": "*:*",
    "red": 0.1,
    "green": 0.1,
    "blue": 0.1,
    "strength": 0.5,
    "draw_mode": "nausea",
    "draw_phase": "above_hud",
    "visible_in_third_person": true,
    "hide_with_hud": true,
    "condition": {
      "type": "origins:all_of",
      "conditions": [
        {
          "type": "apoli:power_active",
          "power": "origins:phantomize"
        },
        {
          "type": "apoli:food_level",
          "comparison": "<=",
          "compare_to": 8
        }
      ]
    }
  }
}
