{
  "type": "origins:multiple",
  "callback": {
    "type": "origins:action_on_callback",
    "entity_action_added": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:execute_command",
          "command": "title @s actionbar {\"text\": \"You have been webbed! Press each direction key once to break free faster!\", \"color\": \"red\"}"
        },
        {
          "type": "origins:grant_power",
          "power": "*:common/restrained",
          "source": "minecraft:ccontrol"
        },
        {
          "type": "origins:change_resource",
          "resource": "*:common/restrained_sources",
          "change": 1
        }
      ]
    },
    "entity_action_lost": {
      "type": "origins:change_resource",
      "resource": "*:common/restrained_sources",
      "change": -1
    }
  },
  "remove": {
    "type": "origins:resource",
    "min": 0,
    "max": 8,
    "start_value": 8,
    "hud_render": {
      "should_render": false
    },
    "min_action": {
      "type": "origins:revoke_power",
      "power": "*:*",
      "source": "minecraft:ccontrol"
    }
  },
  "timer": {
    "type": "origins:action_over_time",
    "interval": 20,
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "*:*_remove",
      "change": -1,
      "operation": "add"
