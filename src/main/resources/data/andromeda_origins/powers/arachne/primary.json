{
  "type": "origins:multiple",
  "primary": {
    "type": "origins:active_self",
    "cooldown": 200,
    "hud_render": {
      "should_render": true,
      "sprite_location": "origins:textures/gui/community/huang/resource_bar_01.png",
      "bar_index": 20
    },
    "entity_action": {
      "type": "origins:if_else_list",
      "actions": [
        {
          "condition": {
            "type": "origins:on_block"
          },
          "action": {
            "type": "origins:and",
            "actions": [
              {
                "type": "origins:grant_power",
                "power": "andromeda_origins:common/dash_projectile_penalty",
                "source": "minecraft:state"
              },
              {
                "type": "origins:change_resource",
                "resource": "andromeda_origins:common/dash_projectile_penalty_remove",
                "change": 3,
                "operation": "set"
              },
              {
                "type": "origins:change_resource",
                "resource": "andromeda_origins:common/figura_1",
                "change": 1,
                "operation": "add"
              },
              {
                "type": "origins:spawn_particles",
                "particle": {
                  "type": "minecraft:spit"
                },
                "count": 10,
                "speed": 0.1,
                "force": true,
                "offset_y": 1,
                "spread": {
                  "x": 0.4,
                  "y": 0.25,
                  "z": 0.4
                }
              },
              {
                "type": "origins:play_sound",
                "sound": "minecraft:entity.spider.ambient",
                "volume": 1,
                "pitch": 0.2
              },
              {
                "type": "origins:grant_power",
                "power": "andromeda_origins:arachne/helper/dash_horizontal",
                "source": "minecraft:state"
              }
            ]
          }
        },
        {
          "condition": {
            "type": "origins:and",
            "conditions": [
              {
                "type": "origins:on_block",
                "inverted": true
              },
              {
                "type": "origins:resource",
                "resource": "*:common/figura_4",
                "comparison": "==",
                "compare_to": 0
              }
            ]
          },
          "action": {
            "type": "origins:raycast",
            "distance": 32,
            "block": true,
            "entity": true,
            "shape_type": "collider",
            "fluid_handling": "none",
            "hit_action": {
              "type": "origins:and",
              "actions": [
                {
                  "type": "origins:grant_power",
                  "power": "andromeda_origins:common/dash_projectile_penalty",
                  "source": "minecraft:state"
                },
                {
                  "type": "origins:change_resource",
                  "resource": "andromeda_origins:common/dash_projectile_penalty_remove",
                  "change": 3,
                  "operation": "set"
                },
                {
                  "type": "origins:play_sound",
                  "sound": "minecraft:entity.llama.spit",
                  "volume": 2,
                  "pitch": 1.5
                },
                {
                  "type": "origins:play_sound",
                  "sound": "item.armor.equip_leather",
                  "volume": 2,
                  "pitch": 0.7
                },
                {
                  "type": "origins:spawn_particles",
                  "particle": {
                    "type": "minecraft:cloud"
                  },
                  "count": 6,
                  "speed": 0.5,
                  "force": true,
                  "offset_y": 0,
                  "spread": {
                    "x": 0.1,
                    "y": 0,
                    "z": 0.1
                  }
                },
                {
                  "type": "origins:add_velocity",
                  "y": 0.2,
                  "z": 2.5,
                  "space": "local",
                  "set": true
                },
                {
                  "type": "origins:set_fall_distance",
                  "fall_distance": 0
                },
                {
                  "type": "origins:change_resource",
                  "resource": "*:common/figura_4",
                  "change": 1,
                  "operation": "set"
                },
                {
                  "type": "origins:grant_power",
                  "power": "*:arachne/helper/pouncing",
                  "source": "minecraft:state"
                }
              ]
            },
            "miss_action": {
              "type": "origins:and",
              "actions": [
                {
                  "type": "origins:execute_command",
                  "command": "title @s actionbar {\"text\": \"You must target an entity or a block!\", \"color\": \"red\"}"
                },
                {
                  "type": "origins:delay",
                  "ticks": 1,
                  "action": {
                    "type": "origins:change_resource",
                    "resource": "*:arachne/primary_primary",
                    "change": 180,
                    "operation": "set"
                  }
                }
              ]
            },
            "command_step": 1,
            "command_along_ray": "particle minecraft:spit",
            "command_along_ray_only_on_hit": true
          }
        }
      ]
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:power",
          "power": "*:common/silenced",
          "inverted": true
        },
        {
          "type": "origins:power",
          "power": "andromeda_origins:common/restrained",
          "inverted": true
        },
        {
          "type": "origins:fluid_height",
          "fluid": "minecraft:lava",
          "comparison": "==",
          "compare_to": 0
        },
        {
          "type": "origins:fluid_height",
          "fluid": "minecraft:water",
          "comparison": "==",
          "compare_to": 0
        }
      ]
    },
    "key": {
      "key": "key.origins.primary_active",
      "continuous": true
    }
  },
  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/toggle.png",
      "text": [
        "Trigger with ",
        {
          "keybind": "key.origins.primary_active"
        }
      ]
    }
  ],
  "name": "Eightfold Swiftness",
  "description": "Press your Primary Ability key on the ground to burst forward for 0.5 seconds. Use it while airborne to fire a strand of silk that pulls you toward a block or creature.\n \nYour projectile damage is reduced by 50% while using this movement and for 3 seconds afterward. §e§lMovement Ability§r."
}
