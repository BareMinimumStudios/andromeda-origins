    "modifier": {
      "id": "*:*",
      "attribute": "minecraft:generic.max_health",
      "operation": "add_value",
      "amount": -2
    }
  },
  "exhaustion": {
    "type": "origins:modify_exhaustion",
    "modifier": {
      "operation": "multiply_total_multiplicative",
      "amount": 0.25
    }
  },
  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/community/silent/badge/shapes/shape_heart.png",
      "text": "§e§lDamage Resistances:§r§f None.\n \n§c§lDamage Vulnerabilities:§r§f None.\n \n§e§lEffect Immunities:§r§f None."
    }
  ],
  "name": "Passive Features",
  "description": "§e§lStats:§r\n-2 Max HP (9 hearts total)\n+25% Hunger Drain\n \n§e§lFeatures:§r\n- Humans possess no innate resistances, immunities, or supernatural passive abilities."
