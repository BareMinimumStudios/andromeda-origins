            },
            {
              "type": "origins:change_resource",
              "resource": "*:siren/helper/infatuated_remove",
              "change": 10,
              "operation": "set"
            },
            {
              "type": "origins:spawn_particles",
              "particle": {
                "type": "minecraft:note"
              },
              "count": 8,
              "speed": 0.04,
              "force": true,
              "spread": {
                "x": 0.3,
                "y": 0.45,
                "z": 0.3
              },
              "offset_y": 1
            },
            {
              "type": "origins:and",
              "actions": [
                {
                  "type": "origins:execute_command",
                  "command": "stopsound @s master andromeda_origins:ability.siren.infatuation_whisper"
                },
                {
                  "type": "origins:execute_command",
                  "command": "playsound andromeda_origins:ability.siren.infatuation_whisper master @s ~ ~ ~ 1.20 1.0 1.0"
                },
                {
                  "type": "origins:execute_command",
                  "command": "playsound andromeda_origins:ability.siren.infatuation_whisper player @a[distance=0.1..32] ~ ~ ~ 0.95 1.0 0"
                },
                {
                  "type": "origins:spawn_particles",
                  "particle": {
                    "type": "minecraft:heart"
                  },
                  "count": 6,
                  "speed": 0.025,
                  "force": true,
                  "spread": {
                    "x": 0.3,
                    "y": 0.5,
                    "z": 0.3
                  },
                  "offset_y": 1
                },
                {
                  "type": "origins:spawn_particles",
                  "particle": {
                    "type": "minecraft:glow"
                  },
                  "count": 4,
                  "speed": 0.015,
                  "force": true,
                  "spread": {
                    "x": 0.25,
                    "y": 0.45,
                    "z": 0.25
                  },
                  "offset_y": 1
                }
              ]
            }
          ]
        }
      },
      "bientity_condition": {
        "type": "origins:and",
        "conditions": [
          {
            "type": "origins:can_see"
          },
          {
            "type": "origins:target_condition",
            "condition": {
              "type": "origins:living"
            }
          }
        ]
      },
      "command_step": 1,
      "command_along_ray": "particle minecraft:happy_villager",
      "command_along_ray_only_on_hit": true
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:power",
          "power": "*:common/silenced",
          "inverted": true
        }
      ]
    },
    "key": {
      "key": "key.origins.primary_active",
      "continuous": false
    }
  },
  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/badge/toggle.png",
      "text": [
        "Trigger with ",
        {
          "keybind": "key.origins.primary_active"
        }
      ]
    },
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/community/silent/badge/colors/red.png",
      "text": "§c§lPacified:§r§f Unable to deal damage."
    },
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/community/silent/badge/colors/red.png",
      "text": "§c§lSilenced:§r§f Unable to use active abilities."
    }
  ],
  "name": "Infatuation Tempo",
  "description": "Press your Primary Ability key while looking at a creature within 30 blocks to Infatuate it for 10 seconds, applying §c§l[Pacified]§r and §c§l[Silenced]§r. While a creature is Infatuated, its attacks and origin-ability damage cannot harm Sirens.\n \nInfatuation lasts the full 10 seconds and cannot be broken early by movement or by taking damage."
}
