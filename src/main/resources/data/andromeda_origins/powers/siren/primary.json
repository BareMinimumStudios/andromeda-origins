              },
              {
                "type": "origins:execute_command",
                "command": "andromedaorigins internal_fx siren.infatuation"
              },
              {
                "type": "origins:execute_command",
                "command": "playsound andromeda_origins:ability.siren.infatuation_charm player @a[distance=0.1..36] ~ ~ ~ 0.95 1.0 0"
              },
              {
                "type": "origins:spawn_particles",
                "particle": {
                  "type": "minecraft:heart"
                },
                "count": 5,
                "speed": 0.03,
                "force": true,
                "spread": {
                  "x": 0.25,
                  "y": 0.4,
                  "z": 0.25
                },
                "offset_y": 1
              },
              {
                "type": "origins:spawn_particles",
                "particle": {
                  "type": "minecraft:glow"
                },
                "count": 5,
                "speed": 0.02,
                "force": true,
                "spread": {
                  "x": 0.3,
                  "y": 0.45,
                  "z": 0.3
                },
                "offset_y": 1
              }
            ]
          },
          {
            "type": "origins:delay",
            "ticks": 3,
            "action": {
              "type": "origins:play_sound",
              "sound": "minecraft:entity.illusioner.cast_spell",
              "volume": 0.65,
              "pitch": 0.25
            }
          },
          {
            "type": "origins:change_resource",
            "resource": "*:common/figura_1",
            "change": 0,
            "operation": "set"
          },
          {
            "type": "origins:revoke_power",
            "power": "*:siren/helper/staring",
            "source": "minecraft:state"
          },
          {
            "type": "origins:change_resource",
            "resource": "*:common/figura_2",
            "change": 1,
            "operation": "set"
          },
          {
            "type": "origins:grant_power",
            "power": "*:siren/helper/finishcasting",
            "source": "minecraft:state"
          },
          {
            "type": "origins:spawn_particles",
            "particle": {
              "type": "minecraft:enchant"
            },
            "count": 8,
            "speed": 0.1,
            "force": true,
            "spread": {
              "x": 0.3,
              "y": 0.4,
              "z": 0.3
            },
            "offset_y": 1
          }
        ]
      },
      "miss_action": {
        "type": "origins:and",
