            "operation": "set"
          },
          {
            "type": "origins:delay",
            "ticks": 4,
            "action": {
              "type": "origins:play_sound",
              "sound": "minecraft:entity.illusioner.prepare_mirror",
              "volume": 0.65,
              "pitch": 0.25
            }
          },
          {
            "type": "origins:grant_power",
            "power": "*:siren/helper/staring",
            "source": "minecraft:state"
          },
          {
            "type": "origins:spawn_particles",
            "particle": {
              "type": "minecraft:note"
            },
            "count": 6,
            "speed": 0.02,
            "force": true,
            "spread": {
              "x": 0.25,
