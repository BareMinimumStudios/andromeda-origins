{
  "type": "origins:multiple",
  "callback": {
    "type": "origins:action_on_callback",
    "entity_action_chosen": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:change_resource",
          "resource": "andromeda_origins:siren/passives_flammable",
          "change": 0,
          "operation": "set"
        },
        {
          "type": "origins:change_resource",
          "resource": "andromeda_origins:siren/primary_active",
          "change": 2400,
          "operation": "set"
        },
        {
          "type": "origins:change_resource",
          "resource": "andromeda_origins:siren/secondary_active",
          "change": 400,
          "operation": "set"
        },
        {
          "type": "origins:execute_command",
          "command": "tag @s add siren"
        },
        {
          "type": "origins:grant_power",
          "power": "*:siren/helper/merlingplus",
          "source": "minecraft:state"
        }
      ]
    },
    "entity_action_lost": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:execute_command",
          "command": "tag @s remove siren"
        },
        {
          "type": "origins:grant_power",
          "power": "*:siren/helper/merlingminus",
          "source": "minecraft:state"
        },
        {
          "type": "origins:grant_power",
          "power": "*:common/debug",
          "source": "minecraft:state"
        }
      ]
    },
    "execute_chosen_when_orb": true
  },
  "heart": {
    "type": "origins:action_over_time",
    "interval": 200,
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:apply_effect",
          "effects": [
            {
              "id": "minecraft:water_breathing",
              "duration": 220,
              "is_ambient": true,
              "show_particles": false,
              "show_icon": false
            },
            {
              "id": "minecraft:haste",
              "duration": 220,
              "is_ambient": true,
              "show_particles": false,
              "show_icon": true,
              "amplifier": 0
            }
          ]
        }
      ]
    }
  },
  "creature_type": {
    "type": "origins:modify_type_tag",
    "tag": "aquatic"
  },
  "waterspeed": {
    "type": "origins:modify_swim_speed",
    "modifier": {
      "id": "andromeda_origins:siren_passives_waterspeed",
      "operation": "add_multiplied_total",
      "amount": 0.25
    }
  },
  "damagedown": {
    "type": "origins:modify_damage_dealt",
    "modifier": {
      "operation": "multiply_total_multiplicative",
      "amount": -0.1
    }
  },
  "vulnerability": {
    "type": "origins:modify_damage_taken",
    "modifier": {
      "operation": "multiply_total_multiplicative",
      "amount": 0.2
    }
  },
  "toggle": {
    "type": "origins:toggle",
    "key": {
      "key": "key.andromeda_origins.toggle",
      "continuous": false
    }
  },
  "darkvision": {
    "type": "origins:night_vision",
    "strength": 0.75,
    "condition": {
      "type": "origins:power_active",
      "power": "*:*_toggle"
    }
  },
  "water_vision": {
    "type": "origins:modify_camera_submersion",
    "from": "water",
    "to": "none",
    "condition": {
      "type": "origins:power_active",
      "power": "*:*_toggle"
    }
  },
  "flammable": {
    "type": "origins:self_action_when_hit",
    "cooldown": 0,
    "hud_render": {
      "should_render": false
    },
    "entity_action": {
      "type": "origins:set_on_fire",
      "duration": 5
    },
    "damage_condition": {
      "type": "origins:fire"
    }
  },
  "badges": [
    {
      "type": "origins:tooltip",
      "sprite": "origins:textures/gui/community/silent/badge/shapes/shape_heart.png",
      "text": "§e§lDamage Resistances:§r§f None.\n \n§c§lDamage Vulnerabilities:§r§f All damage (+20%); iron weapons deal an additional +20%.\n \n§e§lEffect Immunities:§r§f None."
    }
  ],
  "name": "Passive Features",
  "description": "§e§lStats:§r\n+25% Swim Speed\n-10% Damage Dealt\n \n§e§lFeatures:§r\n- Your creature type is Aquatic.\n- You can breathe both air and water and can act in water as though you were on land.\n- You see 75% better in darkness and have perfect underwater vision. Toggleable.\n- You are permanently affected by Haste I.\n- Fire does not extinguish on its own.\n- Iron weapons deal 20% more damage to you and inflict Wither I.\n- You are a Carnivore."
}
