          "pitch": 1.0
        },
        {
          "type": "origins:spawn_particles",
          "particle": {
            "type": "minecraft:sonic_boom"
          },
          "count": 1,
          "speed": 0.0,
          "force": true,
          "offset_y": 1,
          "spread": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          }
        },
        {
          "type": "origins:damage",
          "amount": 6,
          "damage_type": "minecraft:sonic_boom"
        }
      ]
    }
  },
  "remove": {
    "type": "origins:resource",
    "min": 0,
    "max": 5,
    "start_value": 5,
    "hud_render": {
      "sprite_location": "andromeda_origins:textures/gui/resource_bars_2.png",
